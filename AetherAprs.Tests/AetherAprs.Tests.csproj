<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherAprs\AetherAprs.csproj" />
  </ItemGroup>

  <!--
    Android transport and platform helpers that contain no Android types are
    compiled into this desktop test assembly so their validation,
    status-classification, timeout, audio-transfer, route-invalidation,
    notification-descriptor, secret-store-classification and subscription-guard
    behaviour can be unit-tested without a device.
  -->
  <ItemGroup>
    <Compile Include="..\AetherAprs.Android\Services\Transports\BluetoothDeviceAddress.cs"
             Link="Android\Services\Transports\BluetoothDeviceAddress.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Transports\BlockingConnectTimeout.cs"
             Link="Android\Services\Transports\BlockingConnectTimeout.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Transports\GattConnectionPolicy.cs"
             Link="Android\Services\Transports\GattConnectionPolicy.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Platform\AudioWriteLoop.cs"
             Link="Android\Services\Platform\AudioWriteLoop.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Platform\AudioRouteValidator.cs"
             Link="Android\Services\Platform\AudioRouteValidator.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Platform\AudioTransmitGate.cs"
             Link="Android\Services\Platform\AudioTransmitGate.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Platform\NotificationContentSpec.cs"
             Link="Android\Services\Platform\NotificationContentSpec.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Platform\SecretStoreFailureClassifier.cs"
             Link="Android\Services\Platform\SecretStoreFailureClassifier.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Platform\CompassSubscriptionGuard.cs"
             Link="Android\Services\Platform\CompassSubscriptionGuard.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Transports\GattNegotiationProgress.cs"
             Link="Android\Services\Transports\GattNegotiationProgress.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Transports\GattWriteCallbackTracker.cs"
             Link="Android\Services\Transports\GattWriteCallbackTracker.cs" />
    <Compile Include="..\AetherAprs.Android\Services\Transports\GattPayloadSize.cs"
             Link="Android\Services\Transports\GattPayloadSize.cs" />
  </ItemGroup>
</Project>
