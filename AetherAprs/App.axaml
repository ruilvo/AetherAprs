<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AetherAprs"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="AetherAprs.App">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <themes:MaterialTheme BaseTheme="Inherit" PrimaryColor="Green" SecondaryColor="Teal" />
        <dialogHost:DialogHostStyles />
        <materialIcons:MaterialIconStyles />
        <!-- Keep inherited text readable when the requested theme is dark. -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
        </Style>
        <StyleInclude Source="/Styles/PageStyles.axaml" />
        <StyleInclude Source="/Styles/CardStyles.axaml" />
    </Application.Styles>
</Application>
