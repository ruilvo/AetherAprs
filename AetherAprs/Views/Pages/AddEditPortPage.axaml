<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels.Pages"
             xmlns:local="using:AetherAprs"
             xmlns:loc="using:AetherAprs.Localization"
             xmlns:converters="using:AetherAprs.Converters"
             xmlns:bt="using:AetherAprs.Services.Bluetooth"
              xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
              xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
              xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="900"
             x:Class="AetherAprs.Views.Pages.AddEditPortPage"
             x:DataType="vm:AddEditPortViewModel"
             d:DataContext="{x:Static local:DesignData.AddEditPortViewModel}">

  <UserControl.Resources>
    <converters:EnumDisplayConverter x:Key="EnumDisplayConverter" />
    <converters:TypeNameToIsVisibleConverter x:Key="TypeNameToIsVisibleConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="16,16,16,0">
      <TextBlock Text="{Binding Title}"
                 Classes="Headline5"
                 FontWeight="Bold" />
      <TextBlock Text="{loc:Loc ConfigureAprsPortSettings}"
                 Classes="Body2"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
    </StackPanel>

    <!-- Scrollable content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
      <StackPanel Spacing="16" Margin="16" MaxWidth="600">

        <!-- Port Name Section -->
        <StackPanel Spacing="8">
          <TextBox Text="{Binding Name}"
                   PlaceholderText="{loc:Loc PortNamePlaceholder}"
                   wpf:TextFieldAssist.Label="{loc:Loc PortName}"
                   UseFloatingPlaceholder="True" />
        </StackPanel>

        <!-- Port Direction Section -->
        <StackPanel Spacing="12">
          <TextBlock Classes="Subtitle2"
                     Text="{loc:Loc PortDirection}"
                     Foreground="{DynamicResource MaterialOnSurfaceBrush}" />
          <StackPanel Spacing="8" Margin="0,4,0,0">
            <CheckBox Content="{loc:Loc ReceiveRx}"
                      IsChecked="{Binding IsRx}"
                      MinHeight="48"
                      VerticalContentAlignment="Center" />
            <CheckBox Content="{loc:Loc TransmitTx}"
                      IsChecked="{Binding IsTx}"
                      MinHeight="48"
                      VerticalContentAlignment="Center" />
            <CheckBox Content="{loc:Loc ShowOnMap}"
                      IsChecked="{Binding ShowOnMap}"
                      MinHeight="48"
                      VerticalContentAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- Port Type Section -->
        <StackPanel Spacing="8">
          <ComboBox ItemsSource="{Binding PortTypes}"
                    SelectedItem="{Binding SelectedPortSettingsType}"
                    wpf:ComboBoxAssist.Label="{loc:Loc SelectPortType}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:Object">
                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- APRS-IS Settings Section -->
        <StackPanel Spacing="12"
                    IsVisible="{Binding SelectedPortSettingsType, Converter={StaticResource TypeNameToIsVisibleConverter}, ConverterParameter=AprsIsSettings}">
          <TextBlock Classes="Subtitle2"
                     Text="{loc:Loc AprsIsSettings}"
                     Foreground="{DynamicResource MaterialPrimaryBrush}" />

          <StackPanel Spacing="12">
            <TextBox Text="{Binding Server}"
                     PlaceholderText="{loc:Loc ServerPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc Server}"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding ServerPort}"
                     PlaceholderText="{loc:Loc PortPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc Port}"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding Passcode}"
                     PlaceholderText="{loc:Loc PasscodePlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc Passcode}"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding Filter}"
                     PlaceholderText="{loc:Loc FilterPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc FilterOptional}"
                     UseFloatingPlaceholder="True" />
          </StackPanel>
        </StackPanel>

        <!-- KISS Settings Section -->
        <StackPanel Spacing="12"
                    IsVisible="{Binding SelectedPortSettingsType, Converter={StaticResource TypeNameToIsVisibleConverter}, ConverterParameter=KissSettings}">
          <TextBlock Classes="Subtitle2"
                     Text="{loc:Loc KissSettings}"
                     Foreground="{DynamicResource MaterialPrimaryBrush}" />

          <ComboBox ItemsSource="{Binding AvailableKissTransportTypes}"
                    SelectedItem="{Binding SelectedKissTransportType}"
                    wpf:ComboBoxAssist.Label="{loc:Loc Transport}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:Object">
                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- TCP -->
          <StackPanel Spacing="12"
                      IsVisible="{Binding SelectedKissTransportType, Converter={StaticResource TypeNameToIsVisibleConverter}, ConverterParameter=TcpKissTransportSettings}">
            <TextBox Text="{Binding TcpHost}"
                     PlaceholderText="{loc:Loc HostPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc Host}"
                     UseFloatingPlaceholder="True" />
            <TextBox Text="{Binding TcpPort}"
                     PlaceholderText="{loc:Loc SerialPortPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc Port}"
                     UseFloatingPlaceholder="True" />
          </StackPanel>

          <!-- Bluetooth LE -->
          <StackPanel Spacing="12"
                      IsVisible="{Binding SelectedKissTransportType, Converter={StaticResource TypeNameToIsVisibleConverter}, ConverterParameter=BluetoothLeKissTransportSettings}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button MinHeight="48"
                      Padding="16,0"
                      Command="{Binding StartBleScanCommand}"
                      IsEnabled="{Binding !IsBleScanning}"
                      Classes="Outline">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <avalonia:MaterialIcon Kind="Bluetooth" Width="20" Height="20" />
                  <TextBlock Text="{loc:Loc Scan}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button MinHeight="48"
                      Padding="16,0"
                      Command="{Binding StopBleScanCommand}"
                      IsEnabled="{Binding IsBleScanning}"
                      Classes="Outline">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <avalonia:MaterialIcon Kind="Stop" Width="20" Height="20" />
                  <TextBlock Text="{loc:Loc Stop}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding BleStatusText}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding BleStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource MaterialErrorBrush}" />
            <controls:Card Padding="0" Margin="0">
              <ListBox ItemsSource="{Binding BleDevices}"
                       SelectedItem="{Binding SelectedBleDevice}"
                       MaxHeight="180"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="bt:BluetoothLeAdvertisement">
                    <StackPanel Spacing="4" Margin="0,4">
                      <TextBlock Text="{Binding Name, TargetNullValue={loc:Loc UnnamedDevice}}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Address}" Opacity="0.7" FontSize="12" />
                      <TextBlock Text="{Binding Rssi, StringFormat='RSSI: {0} dBm'}" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </controls:Card>
          </StackPanel>

          <!-- Bluetooth Classic SPP -->
          <StackPanel Spacing="12"
                      IsVisible="{Binding SelectedKissTransportType, Converter={StaticResource TypeNameToIsVisibleConverter}, ConverterParameter=BluetoothClassicKissTransportSettings}">
            <Button MinHeight="48"
                    Padding="16,0"
                    HorizontalAlignment="Left"
                    Command="{Binding RefreshSppDevicesCommand}"
                    Classes="Outline">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <avalonia:MaterialIcon Kind="Refresh" Width="20" Height="20" />
                <TextBlock Text="{loc:Loc Refresh}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding SppStatusText}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding SppStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource MaterialErrorBrush}" />
            <controls:Card Padding="0" Margin="0">
              <ListBox ItemsSource="{Binding SppDevices}"
                       SelectedItem="{Binding SelectedSppDevice}"
                       MaxHeight="180"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="bt:BluetoothClassicDevice">
                    <StackPanel Spacing="4" Margin="0,4">
                      <TextBlock Text="{Binding Name, TargetNullValue={loc:Loc UnnamedDevice}}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Address}" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </controls:Card>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Action buttons (sticky at bottom) -->
    <Border Grid.Row="2"
            Background="{DynamicResource MaterialBackgroundBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource MaterialDividerBrush}"
            Padding="16">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="{loc:Loc Cancel}"
                MinWidth="80"
                MinHeight="48"
                Command="{Binding CancelCommand}"
                Classes="Outline" />
        <Button Content="{loc:Loc Save}"
                MinWidth="80"
                MinHeight="48"
                Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
