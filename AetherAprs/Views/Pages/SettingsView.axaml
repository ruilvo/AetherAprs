<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:local="using:AetherAprs"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:components="using:AetherAprs.Views.Components"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:AetherAprs.Localization"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel"
             d:DataContext="{x:Static local:DesignData.SettingsViewModel}">
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer>
      <StackPanel Spacing="24" Margin="16,16,16,80" MaxWidth="600">

        <!-- Station Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="Headline5"
                     Text="{loc:Loc StationSettings}"
                     Foreground="{DynamicResource MaterialPrimaryBrush}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc StationSettingsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

          <StackPanel Spacing="12">
            <!-- Callsign -->
            <TextBox x:Name="CallsignBox"
                     Text="{Binding Callsign}"
                     PlaceholderText="e.g. N0CALL"
                     wpf:TextFieldAssist.Label="{loc:Loc Callsign}"
                     UseFloatingPlaceholder="True" />

            <!-- Default SSID -->
            <TextBox x:Name="SsidBox"
                     Text="{Binding DefaultSsid, TargetNullValue=''}"
                     PlaceholderText="0"
                     wpf:TextFieldAssist.Label="{loc:Loc DefaultSsidLabel}"
                     UseFloatingPlaceholder="True" />

            <components:AprsSymbolPickerView
              DataContext="{Binding SymbolPicker}" />
          </StackPanel>
        </StackPanel>

        <!-- Placeholder for future settings sections -->
        <StackPanel Spacing="16">
          <TextBlock Classes="Headline5"
                     Text="{loc:Loc DynamicBeaconing}"
                     Foreground="{DynamicResource MaterialPrimaryBrush}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc DynamicBeaconingDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

          <Button Content="{loc:Loc ConfigureBeaconingModes}"
                  Command="{Binding OpenBeaconingSettingsCommand}"
                  x:Name="ConfigureBeaconingButton"
                  MinWidth="120"
                  MinHeight="48"
                  Classes="Outline" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
