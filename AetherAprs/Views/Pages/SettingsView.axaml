<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:local="using:AetherAprs"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel"
             d:DataContext="{x:Static local:DesignData.SettingsViewModel}">
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="24" Margin="16,16,16,16" MaxWidth="600">

        <!-- Station Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="Headline5"
                     Text="Station Settings"
                     Foreground="{DynamicResource MaterialPrimaryBrush}" />

          <TextBlock Classes="Body2"
                     Text="Configure your station identity used for APRS."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

          <StackPanel Spacing="12">
            <!-- Callsign -->
            <TextBox x:Name="CallsignBox"
                     Text="{Binding Callsign}"
                     PlaceholderText="e.g. N0CALL"
                     wpf:TextFieldAssist.Label="Callsign"
                     UseFloatingPlaceholder="True" />

            <!-- Default SSID -->
            <TextBox x:Name="SsidBox"
                     Text="{Binding DefaultSsid}"
                     PlaceholderText="0"
                     wpf:TextFieldAssist.Label="Default SSID"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding DefaultSymbolTableCharacter}"
                     MaxLength="1"
                     PlaceholderText="/"
                     wpf:TextFieldAssist.Label="Default symbol table"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding DefaultSymbolCodeCharacter}"
                     MaxLength="1"
                     PlaceholderText="["
                     wpf:TextFieldAssist.Label="Default symbol code"
                     UseFloatingPlaceholder="True" />

            <ComboBox ItemsSource="{Binding BeaconModes}"
                      SelectedItem="{Binding DefaultBeaconMode}"
                      wpf:ComboBoxAssist.Label="Default beacon mode">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:Object">
                  <TextBlock Text="{Binding}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Success message -->
            <TextBlock Text="✓ Settings saved!"
                       IsVisible="{Binding IsSaved}"
                       Foreground="{DynamicResource MaterialSuccessBrush}"
                       Margin="0,12,0,0"
                       Classes="Caption" />
          </StackPanel>
        </StackPanel>

        <!-- Placeholder for future settings sections -->
        <StackPanel Spacing="16">
          <TextBlock Classes="Headline5"
                     Text="Dynamic Beaconing"
                     Foreground="{DynamicResource MaterialPrimaryBrush}" />

          <TextBlock Classes="Body2"
                     Text="Configure intelligent position beaconing with smart transmit intervals."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

          <Button Content="Configure Beaconing Modes"
                  Click="OnConfigureBeaconingClick"
                  x:Name="ConfigureBeaconingButton"
                  MinWidth="120"
                  MinHeight="40"
                  Classes="Outlined" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Save Button (sticky at bottom) -->
    <Border Grid.Row="1"
            Background="{DynamicResource MaterialBackgroundBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource MaterialDividerBrush}"
            Padding="16">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="Save"
                Command="{Binding SaveCommand}"
                MinWidth="80"
                MinHeight="36"
                Classes="Filled" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
