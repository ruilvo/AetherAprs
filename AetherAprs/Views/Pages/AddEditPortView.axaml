<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:local="using:AetherAprs"
             xmlns:converters="using:AetherAprs.Converters"
             xmlns:bt="using:AetherAprs.Services.Bluetooth"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:components="using:AetherAprs.Views.Components"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="900"
             x:Class="AetherAprs.Views.Pages.AddEditPortView"
             x:DataType="vm:AddEditPortDialogViewModel"
             d:DataContext="{x:Static local:DesignData.AddEditPortDialogViewModel}">

  <UserControl.Resources>
    <converters:EnumDisplayConverter x:Key="EnumDisplayConverter" />
    <converters:PortTypeToIsVisibleConverter x:Key="PortTypeToIsVisibleConverter" />
    <converters:KissTransportKindToIsVisibleConverter x:Key="KissTransportKindToIsVisibleConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="16,16,16,0">
      <TextBlock Text="{Binding Title}"
                 Classes="Headline5"
                 FontWeight="Bold" />
      <TextBlock Text="Configure your APRS port settings"
                 Classes="Body2"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
    </StackPanel>

    <!-- Scrollable content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
      <StackPanel Spacing="20" Margin="16" MaxWidth="600">

        <!-- Port Name Section -->
        <StackPanel Spacing="8">
          <TextBox Text="{Binding Name}"
                   PlaceholderText="e.g. APRS-IS Port 1"
                   wpf:TextFieldAssist.Label="Port Name"
                   UseFloatingPlaceholder="True" />
        </StackPanel>

        <!-- Port Direction Section -->
        <StackPanel Spacing="12">
          <TextBlock Classes="Subtitle2"
                     Text="Port Direction"
                     Foreground="{DynamicResource MaterialOnSurfaceBrush}" />
          <StackPanel Spacing="8" Margin="0,4,0,0">
            <CheckBox Content="Receive (Rx)"
                      IsChecked="{Binding IsRx}"
                      MinHeight="40"
                      VerticalContentAlignment="Center" />
            <CheckBox Content="Transmit (Tx)"
                      IsChecked="{Binding IsTx}"
                      MinHeight="40"
                      VerticalContentAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- Dynamic Beaconing Mode Section -->
        <StackPanel Spacing="8">
          <ComboBox ItemsSource="{Binding BeaconModes}"
                    SelectedItem="{Binding SelectedBeaconMode}"
                    IsEnabled="{Binding UseDefaultBeaconMode, Converter={StaticResource InverseBooleanConverter}}"
                    wpf:ComboBoxAssist.Label="Dynamic Beaconing Mode">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:Object">
                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="Use default beacon mode"
                    IsChecked="{Binding UseDefaultBeaconMode}"
                    MinHeight="40"
                    VerticalContentAlignment="Center" />
        </StackPanel>

        <components:AprsSymbolPickerView
          TableCharacter="{Binding SymbolTableCharacter, Mode=TwoWay}"
          CodeCharacter="{Binding SymbolCodeCharacter, Mode=TwoWay}"
          UseDefault="{Binding UseDefaultSymbol, Mode=TwoWay}"
            ShowInheritOption="True" />

        <!-- Shared SSID -->
        <StackPanel Spacing="8">
          <TextBox Text="{Binding Ssid}"
                   PlaceholderText="Leave empty for default"
                   wpf:TextFieldAssist.Label="SSID"
                   UseFloatingPlaceholder="True" />
        </StackPanel>

        <!-- Port Type Section -->
        <StackPanel Spacing="8">
          <ComboBox ItemsSource="{Binding PortTypes}"
                    SelectedItem="{Binding SelectedPortType}"
                    wpf:ComboBoxAssist.Label="Select a port type">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:Object">
                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- APRS-IS Settings Section -->
        <StackPanel Spacing="12"
                    IsVisible="{Binding SelectedPortType, Converter={StaticResource PortTypeToIsVisibleConverter}, ConverterParameter=AprsIs}">
          <TextBlock Classes="Subtitle2"
                     Text="APRS-IS Settings"
                     Foreground="{DynamicResource MaterialPrimaryBrush}" />

          <StackPanel Spacing="12">
            <TextBox Text="{Binding Server}"
                     PlaceholderText="e.g. euro.aprs2.net"
                     wpf:TextFieldAssist.Label="Server"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding ServerPort}"
                     PlaceholderText="14580"
                     wpf:TextFieldAssist.Label="Port"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding Passcode}"
                     PlaceholderText="Auto-filled from callsign"
                     wpf:TextFieldAssist.Label="Passcode"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding Filter}"
                     PlaceholderText="e.g. m/50"
                     wpf:TextFieldAssist.Label="Filter (optional)"
                     UseFloatingPlaceholder="True" />
          </StackPanel>
        </StackPanel>

        <!-- KISS Settings Section -->
        <StackPanel Spacing="12"
                    IsVisible="{Binding SelectedPortType, Converter={StaticResource PortTypeToIsVisibleConverter}, ConverterParameter=Kiss}">
          <TextBlock Classes="Subtitle2"
                     Text="KISS Settings"
                     Foreground="{DynamicResource MaterialPrimaryBrush}" />

          <ComboBox ItemsSource="{Binding AvailableKissTransportKinds}"
                    SelectedItem="{Binding SelectedKissTransportKind}"
                    wpf:ComboBoxAssist.Label="Transport">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:Object">
                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <!-- TCP -->
          <StackPanel Spacing="12"
                      IsVisible="{Binding SelectedKissTransportKind, Converter={StaticResource KissTransportKindToIsVisibleConverter}, ConverterParameter=Tcp}">
            <TextBox Text="{Binding TcpHost}"
                     PlaceholderText="127.0.0.1"
                     wpf:TextFieldAssist.Label="Host"
                     UseFloatingPlaceholder="True" />
            <TextBox Text="{Binding TcpPort}"
                     PlaceholderText="8001"
                     wpf:TextFieldAssist.Label="Port"
                     UseFloatingPlaceholder="True" />
          </StackPanel>

          <!-- Bluetooth LE -->
          <StackPanel Spacing="12"
                      IsVisible="{Binding SelectedKissTransportKind, Converter={StaticResource KissTransportKindToIsVisibleConverter}, ConverterParameter=BluetoothLe}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button MinHeight="36"
                      Padding="12,0"
                      Command="{Binding StartBleScanCommand}"
                      IsEnabled="{Binding !IsBleScanning}"
                      Classes="Outline">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <avalonia:MaterialIcon Kind="Bluetooth" Width="18" Height="18" />
                  <TextBlock Text="Scan" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button MinHeight="36"
                      Padding="12,0"
                      Command="{Binding StopBleScanCommand}"
                      IsEnabled="{Binding IsBleScanning}"
                      Classes="Outline">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <avalonia:MaterialIcon Kind="Stop" Width="18" Height="18" />
                  <TextBlock Text="Stop" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding BleStatusText}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding BleStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource MaterialErrorBrush}" />
            <controls:Card Padding="0" Margin="0">
              <ListBox ItemsSource="{Binding BleDevices}"
                       SelectedItem="{Binding SelectedBleDevice}"
                       MaxHeight="180"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="bt:BluetoothLeAdvertisement">
                    <StackPanel Spacing="2" Margin="0,4">
                      <TextBlock Text="{Binding Name, TargetNullValue='(unnamed)'}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Address}" Opacity="0.7" FontSize="12" />
                      <TextBlock Text="{Binding Rssi, StringFormat='RSSI: {0} dBm'}" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </controls:Card>
          </StackPanel>

          <!-- Bluetooth Classic SPP -->
          <StackPanel Spacing="12"
                      IsVisible="{Binding SelectedKissTransportKind, Converter={StaticResource KissTransportKindToIsVisibleConverter}, ConverterParameter=BluetoothClassic}">
            <Button MinHeight="36"
                    Padding="12,0"
                    HorizontalAlignment="Left"
                    Command="{Binding RefreshSppDevicesCommand}"
                    Classes="Outline">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <avalonia:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                <TextBlock Text="Refresh" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding SppStatusText}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding SppStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource MaterialErrorBrush}" />
            <controls:Card Padding="0" Margin="0">
              <ListBox ItemsSource="{Binding SppDevices}"
                       SelectedItem="{Binding SelectedSppDevice}"
                       MaxHeight="180"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="bt:BluetoothClassicDevice">
                    <StackPanel Spacing="2" Margin="0,4">
                      <TextBlock Text="{Binding Name, TargetNullValue='(unnamed)'}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Address}" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </controls:Card>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Action buttons (sticky at bottom) -->
    <Border Grid.Row="2"
            Background="{DynamicResource MaterialBackgroundBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource MaterialDividerBrush}"
            Padding="16">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="Cancel"
                MinWidth="80"
                MinHeight="36"
                Command="{Binding CancelCommand}"
                Classes="Outline" />
        <Button Content="Save"
                MinWidth="80"
                MinHeight="36"
                IsEnabled="{Binding IsSymbolValid}"
                Command="{Binding SaveCommand}"
                Classes="Filled" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>