<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels.Pages"
             xmlns:local="using:AetherAprs"
             xmlns:config="using:AetherAprs.Configuration"
             xmlns:converters="using:AetherAprs.Converters.UI"
             xmlns:aprsConverters="using:AetherAprs.Converters.Aprs"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:components="using:AetherAprs.Views.Components"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
              xmlns:dialogHost="clr-namespace:DialogHost.Avalonia;assembly=DialogHost.Avalonia"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:AetherAprs.Localization"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             d:DataContext="{x:Static local:DesignData.SettingsViewModel}">
  <UserControl.Resources>
    <converters:PacketDisplayTimeRangeConverter x:Key="TimeRangeConverter" />
    <converters:TileSourceTypeConverter x:Key="TileSourceConverter" />
    <converters:ThemeModeConverter x:Key="ThemeModeConverter" />
    <converters:PositionFormatConverter x:Key="PositionFormatConverter" />
    <aprsConverters:AprsSsidConverter x:Key="SsidConverter" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
  </UserControl.Styles>

  <components:ScrollablePageContent>
    <StackPanel Classes="SettingsContainer">

        <!-- Station Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc StationSettings}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc StationSettingsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}" />

          <StackPanel Spacing="12">
            <!-- Callsign -->
            <TextBox x:Name="CallsignBox"
                     Text="{Binding Callsign}"
                     PlaceholderText="{loc:Loc CallsignPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc Callsign}"
                     UseFloatingPlaceholder="True" />

            <!-- SSID -->
            <ComboBox x:Name="SsidBox"
                      ItemsSource="{Binding AvailableSsids}"
                      SelectedItem="{Binding Ssid}"
                      MinHeight="48"
                      wpf:ComboBoxAssist.Label="{loc:Loc DefaultSsidLabel}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource SsidConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <ContentControl Content="{Binding SymbolPicker}" />
          </StackPanel>
        </StackPanel>

        <!-- Display Settings Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc DisplaySettings}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc DisplaySettingsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}" />

          <StackPanel Spacing="12">
            <!-- Time Range Selection -->
            <ComboBox ItemsSource="{Binding AvailableTimeRanges}"
                      SelectedItem="{Binding DisplayTimeRange}"
                      MinHeight="48"
                      wpf:ComboBoxAssist.Label="{loc:Loc PacketDisplayTimeRangeLabel}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource TimeRangeConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Custom Hours - only visible when Custom is selected -->
            <TextBox Text="{Binding CustomDisplayTimeRangeHours}"
                     PlaceholderText="12"
                     wpf:TextFieldAssist.Label="{loc:Loc CustomTimeRangeHoursLabel}"
                     UseFloatingPlaceholder="True"
                     IsVisible="{Binding DisplayTimeRange, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter={x:Static config:PacketDisplayTimeRange.Custom}}" />

            <!-- Load history on startup -->
            <CheckBox Content="{loc:Loc LoadHistoryOnStartup}"
                      IsChecked="{Binding LoadHistoryOnStartup}"
                      MinHeight="48"
                      VerticalContentAlignment="Center" />

            <TextBlock Classes="Caption"
                       Text="{loc:Loc LoadHistoryOnStartupDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialBodyLightBrush}"
                       Margin="0,-8,0,0" />

            <!-- Theme -->
            <ComboBox ItemsSource="{Binding AvailableThemes}"
                      SelectedItem="{Binding Theme}"
                      MinHeight="48"
                      wpf:ComboBoxAssist.Label="{loc:Loc ThemeLabel}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource ThemeModeConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </StackPanel>

        <!-- Map Settings Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc MapSettings}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc MapSettingsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}" />

          <StackPanel Spacing="12">
            <ComboBox ItemsSource="{Binding AvailableTileSources}"
                      SelectedItem="{Binding TileSource}"
                      MinHeight="48"
                      wpf:ComboBoxAssist.Label="{loc:Loc TileSourceLabel}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource TileSourceConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Text="{Binding MbTilesFilePath}"
                     PlaceholderText="{loc:Loc MbTilesFilePathPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc MbTilesFilePathLabel}"
                     UseFloatingPlaceholder="True"
                     IsVisible="{Binding TileSource, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter={x:Static config:TileSourceType.MbTilesOffline}}" />

            <Button Content="{loc:Loc DownloadOfflineMap}"
                    Command="{Binding OpenDownloadOfflineMapCommand}"
                    MinWidth="120"
                    MinHeight="48"
                    Classes="Outline" />
          </StackPanel>
        </StackPanel>

        <!-- Dynamic Beaconing Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc DynamicBeaconing}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc DynamicBeaconingDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}" />

          <Button Content="{loc:Loc ConfigureBeaconingModes}"
                  Command="{Binding OpenBeaconingSettingsCommand}"
                  x:Name="ConfigureBeaconingButton"
                  MinWidth="120"
                  MinHeight="48"
                  Classes="Outline" />
        </StackPanel>

        <!-- Beacon Settings Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc BeaconSettings}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc BeaconSettingsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}" />

          <StackPanel Spacing="12">
            <ComboBox ItemsSource="{Binding AvailablePositionFormats}"
                      SelectedItem="{Binding PositionFormat}"
                      MinHeight="48"
                      wpf:ComboBoxAssist.Label="{loc:Loc PositionFormatLabel}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource PositionFormatConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Classes="Caption"
                       Text="{loc:Loc PositionFormatDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialBodyLightBrush}"
                       Margin="0,-8,0,0" />

            <TextBox Text="{Binding BeaconComment}"
                     PlaceholderText="{loc:Loc DefaultBeaconCommentPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc DefaultBeaconComment}"
                     UseFloatingPlaceholder="True"
                     MaxLength="43" />

            <TextBox Text="{Binding DigipeaterPath}"
                     PlaceholderText="{loc:Loc DigipeaterPathPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc DigipeaterPath}"
                     UseFloatingPlaceholder="True" />

            <TextBlock Classes="Caption"
                       Text="{loc:Loc DigipeaterPathDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialBodyLightBrush}"
                       Margin="0,-8,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- Digipeater and Gating Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc DigipeaterAndGating}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc DigipeaterGatingDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}" />

          <StackPanel Spacing="12">
            <CheckBox Content="{loc:Loc EnableDigipeater}"
                      IsChecked="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center" />

            <CheckBox Content="{loc:Loc InsertStationCallsignInPath}"
                      IsChecked="{Binding DigipeaterInsertCallsign}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />

            <CheckBox Content="{loc:Loc RespondToWide1}"
                      IsChecked="{Binding DigipeaterRespondToWide1}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />

            <CheckBox Content="{loc:Loc RespondToWide2}"
                      IsChecked="{Binding DigipeaterRespondToWide2}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />

            <CheckBox Content="{loc:Loc RespondToTrace}"
                      IsChecked="{Binding DigipeaterRespondToTrace}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />

            <CheckBox Content="{loc:Loc EnableAprsIsToRfGating}"
                      IsChecked="{Binding EnableAprsIsToRfGate}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />

            <TextBox Text="{Binding AprsIsToRfAllowlist}"
                     PlaceholderText="{loc:Loc AprsIsToRfAllowlistPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc AprsIsToRfAllowlistLabel}"
                     UseFloatingPlaceholder="True"
                     IsEnabled="{Binding EnableAprsIsToRfGate}"
                     Margin="24,0,0,0" />

            <TextBlock Classes="Caption"
                       Text="{loc:Loc AprsIsToRfAllowlistDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialBodyLightBrush}"
                       Margin="24,-8,0,0" />

            <TextBlock Classes="Caption"
                       Text="{Binding AprsIsToRfAllowlistErrorMessage}"
                       IsVisible="{Binding AprsIsToRfAllowlistErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialValidationErrorBrush}"
                       Margin="24,0,0,0" />

            <CheckBox Content="{loc:Loc EnableRfToAprsIsGating}"
                      IsChecked="{Binding EnableRfToAprsIsGate}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- Messaging Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc Messaging}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc MessagingDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}" />

          <StackPanel Spacing="12">
            <CheckBox Content="{loc:Loc AutoAcknowledgeIncomingMessages}"
                      IsChecked="{Binding AutoAcknowledgeMessages}"
                      MinHeight="48"
                      VerticalContentAlignment="Center" />

            <TextBox Text="{Binding MessageMaxRetries}"
                     PlaceholderText="5"
                     wpf:TextFieldAssist.Label="{loc:Loc MaximumRetryAttempts}"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding MessageRetryTimeoutSeconds}"
                     PlaceholderText="30"
                     wpf:TextFieldAssist.Label="{loc:Loc InitialRetryTimeoutSeconds}"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding MessageExpiryMinutes}"
                     PlaceholderText="15"
                     wpf:TextFieldAssist.Label="{loc:Loc MessageExpiryMinutes}"
                     UseFloatingPlaceholder="True" />

            <CheckBox Content="{loc:Loc ShowMessageTextInNotifications}"
                      IsChecked="{Binding ShowMessageTextInNotifications}"
                      MinHeight="48"
                      VerticalContentAlignment="Center" />

            <controls:Card Classes="ClickableCard">
              <Button Command="{Binding OpenMessageTemplatesCommand}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Loc MessageTemplatesSectionEntry}"
                               Classes="Subtitle1"
                               FontWeight="Medium" />
                    <TextBlock Text="{loc:Loc MessageTemplatesSectionEntryDescription}"
                               Classes="Body2"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MaterialBodyLightBrush}" />
                  </StackPanel>
                  <avalonia:MaterialIcon Grid.Column="1"
                                         Kind="ChevronRight"
                                         AutomationProperties.IsControlElementOverride="False"
                                         Width="24"
                                         Height="24"
                                         VerticalAlignment="Center" />
                </Grid>
              </Button>
            </controls:Card>
          </StackPanel>
        </StackPanel>

        <!-- Support Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc SupportPageTitle}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc SupportPageDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}" />

          <Button Content="{loc:Loc SupportSectionEntry}"
                  Command="{Binding OpenSupportCommand}"
                  MinWidth="120"
                  MinHeight="48"
                  Classes="Outline" />
        </StackPanel>

      </StackPanel>
  </components:ScrollablePageContent>
</UserControl>
