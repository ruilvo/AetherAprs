<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:local="using:AetherAprs"
             xmlns:config="using:AetherAprs.Configuration"
             xmlns:converters="using:AetherAprs.Converters"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:components="using:AetherAprs.Views.Components"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:AetherAprs.Localization"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             d:DataContext="{x:Static local:DesignData.SettingsViewModel}">
  <UserControl.Resources>
    <converters:PacketDisplayTimeRangeConverter x:Key="TimeRangeConverter" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="MinHeight" Value="48" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer Classes="PageContent">
      <StackPanel Classes="SettingsContainer">

        <!-- Station Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc StationSettings}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc StationSettingsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

          <StackPanel Spacing="12">
            <!-- Callsign -->
            <TextBox x:Name="CallsignBox"
                     Text="{Binding Callsign}"
                     PlaceholderText="e.g. N0CALL"
                     wpf:TextFieldAssist.Label="{loc:Loc Callsign}"
                     UseFloatingPlaceholder="True" />

            <!-- SSID -->
            <TextBox x:Name="SsidBox"
                     Text="{Binding Ssid}"
                     PlaceholderText="0"
                     wpf:TextFieldAssist.Label="{loc:Loc DefaultSsidLabel}"
                     UseFloatingPlaceholder="True" />

            <components:AprsSymbolPickerComponent
              DataContext="{Binding SymbolPicker}" />
          </StackPanel>
        </StackPanel>

        <!-- Display Settings Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc DisplaySettings}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc DisplaySettingsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

          <StackPanel Spacing="12">
            <!-- Time Range Selection -->
            <ComboBox ItemsSource="{Binding AvailableTimeRanges}"
                      SelectedItem="{Binding DisplayTimeRange}"
                      MinHeight="48"
                      wpf:ComboBoxAssist.Label="Packet Display Time Range"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource TimeRangeConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Custom Hours - only visible when Custom is selected -->
            <TextBox Text="{Binding CustomDisplayTimeRangeHours}"
                     PlaceholderText="12"
                     wpf:TextFieldAssist.Label="Custom Time Range (hours) - used when Custom is selected"
                     UseFloatingPlaceholder="True"
                     IsVisible="{Binding DisplayTimeRange, Converter={x:Static converters:EnumToBoolConverter.Instance}, ConverterParameter={x:Static config:PacketDisplayTimeRange.Custom}}" />
          </StackPanel>
        </StackPanel>

        <!-- Dynamic Beaconing Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc DynamicBeaconing}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc DynamicBeaconingDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

          <Button Content="{loc:Loc ConfigureBeaconingModes}"
                  Command="{Binding OpenBeaconingSettingsCommand}"
                  x:Name="ConfigureBeaconingButton"
                  MinWidth="120"
                  MinHeight="48"
                  Classes="Outline" />
        </StackPanel>

        <!-- Beacon Settings Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc BeaconSettings}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc BeaconSettingsDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

          <StackPanel Spacing="12">
            <TextBox Text="{Binding DefaultBeaconComment}"
                     PlaceholderText="{loc:Loc DefaultBeaconCommentPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc DefaultBeaconComment}"
                     UseFloatingPlaceholder="True"
                     MaxLength="43" />

            <TextBox Text="{Binding DigipeaterPath}"
                     PlaceholderText="{loc:Loc DigipeaterPathPlaceholder}"
                     wpf:TextFieldAssist.Label="{loc:Loc DigipeaterPath}"
                     UseFloatingPlaceholder="True" />

            <TextBlock Classes="Caption"
                       Text="{loc:Loc DigipeaterPathDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialSecondaryBodyBrush}"
                       Margin="0,-8,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- Digipeater and Gating Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc DigipeaterAndGating}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc DigipeaterGatingDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

          <StackPanel Spacing="12">
            <CheckBox Content="{loc:Loc EnableDigipeater}"
                      IsChecked="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center" />

            <CheckBox Content="{loc:Loc InsertStationCallsignInPath}"
                      IsChecked="{Binding DigipeaterInsertCallsign}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />

            <CheckBox Content="{loc:Loc RespondToWide1}"
                      IsChecked="{Binding DigipeaterRespondToWide1}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />

            <CheckBox Content="{loc:Loc RespondToWide2}"
                      IsChecked="{Binding DigipeaterRespondToWide2}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />

            <CheckBox Content="{loc:Loc EnableAprsIsToRfGating}"
                      IsChecked="{Binding EnableAprsIsToRfGate}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />

            <CheckBox Content="{loc:Loc EnableRfToAprsIsGating}"
                      IsChecked="{Binding EnableRfToAprsIsGate}"
                      IsEnabled="{Binding EnableDigipeater}"
                      MinHeight="48"
                      VerticalContentAlignment="Center"
                      Margin="24,0,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- Messaging Section -->
        <StackPanel Spacing="16">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc Messaging}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc MessagingDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

          <StackPanel Spacing="12">
            <CheckBox Content="{loc:Loc AutoAcknowledgeIncomingMessages}"
                      IsChecked="{Binding AutoAcknowledgeMessages}"
                      MinHeight="48"
                      VerticalContentAlignment="Center" />

            <TextBox Text="{Binding MessageMaxRetries}"
                     PlaceholderText="5"
                     wpf:TextFieldAssist.Label="{loc:Loc MaximumRetryAttempts}"
                     UseFloatingPlaceholder="True" />

            <TextBox Text="{Binding MessageRetryTimeoutSeconds}"
                     PlaceholderText="30"
                     wpf:TextFieldAssist.Label="{loc:Loc InitialRetryTimeoutSeconds}"
                     UseFloatingPlaceholder="True" />
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
