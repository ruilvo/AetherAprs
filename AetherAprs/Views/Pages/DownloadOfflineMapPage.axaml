<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels.Pages"
             xmlns:local="using:AetherAprs"
             xmlns:loc="using:AetherAprs.Localization"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="1000"
             x:Class="AetherAprs.Views.Pages.DownloadOfflineMapPage"
             x:DataType="vm:DownloadOfflineMapViewModel"
             d:DataContext="{x:Static local:DesignData.DownloadOfflineMapViewModel}">
  <UserControl.Styles>
    <Style Selector="NumericUpDown">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,3*,2*,Auto">

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="16,16,16,8" Spacing="8">
      <TextBlock Classes="PageTitle"
                 Text="{loc:Loc DownloadOfflineMap}" />
      <TextBlock Classes="PageSubtitle"
                 Text="{loc:Loc DownloadOfflineMapDescription}" />
    </StackPanel>

    <!-- Interactive selection map -->
    <Border Grid.Row="1"
            Margin="16,0"
            CornerRadius="8"
            ClipToBounds="True"
            BorderThickness="1"
            BorderBrush="{DynamicResource MaterialDividerBrush}">
      <mapsui:MapControl x:Name="SelectionMap" />
    </Border>

    <!-- Controls -->
    <ScrollViewer Grid.Row="2">
      <StackPanel Classes="PageContainer">

        <StackPanel Spacing="12">
          <TextBlock Classes="Body2"
                     Text="{loc:Loc OfflineMapDrawInstructions}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding DrawModeButtonLabel}"
                    Command="{Binding ToggleDrawModeCommand}"
                    MinHeight="48" />
            <Button Content="{loc:Loc OfflineMapClearSelection}"
                    Command="{Binding ClearSelectionCommand}"
                    Classes="Outline"
                    MinHeight="48"
                    IsVisible="{Binding HasSelection}" />
          </StackPanel>

          <TextBlock Classes="Body2"
                     Text="{Binding SelectionLabel}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}"
                     IsVisible="{Binding HasSelection}" />
        </StackPanel>

        <!-- Zoom range -->
        <StackPanel Spacing="8">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc DownloadZoomRange}" />

          <TextBlock Classes="Body2"
                     Text="{loc:Loc DownloadZoomRangeDescription}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Classes="Body2" Text="{loc:Loc MinZoom}" />
              <NumericUpDown Value="{Binding MinZoom}"
                             Minimum="0"
                             Maximum="19"
                             Increment="1" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="Body2" Text="{loc:Loc MaxZoom}" />
              <NumericUpDown Value="{Binding MaxZoom}"
                             Minimum="0"
                             Maximum="19"
                             Increment="1" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Progress -->
        <StackPanel Spacing="8">
          <ProgressBar Minimum="0"
                       Maximum="100"
                       Value="{Binding ProgressPercent}"
                       IsVisible="{Binding IsDownloading}" />
          <TextBlock Text="{Binding StatusMessage}"
                     Classes="Body2"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialBodyLightBrush}"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Action Buttons (sticky at bottom) -->
    <Border Grid.Row="3"
            Background="{DynamicResource MaterialBackgroundBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource MaterialDividerBrush}"
            Padding="16">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="{loc:Loc Cancel}"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsDownloading}"
                MinWidth="80"
                MinHeight="48"
                Classes="Outline" />
        <Button Content="{loc:Loc Download}"
                Command="{Binding DownloadCommand}"
                MinWidth="80"
                MinHeight="48" />
        <Button Content="{loc:Loc Close}"
                Command="{Binding CloseCommand}"
                MinWidth="80"
                MinHeight="48"
                Classes="Outline" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
