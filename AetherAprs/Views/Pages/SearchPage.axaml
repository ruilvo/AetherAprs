<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels.Pages"
             xmlns:local="using:AetherAprs"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:AetherAprs.Localization"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:converters="using:AetherAprs.Converters.UI"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             d:DataContext="{x:Static local:DesignData.SearchViewModel}">

  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Classes="PageHeader" Margin="16,16,16,0" Orientation="Horizontal" Spacing="8">
      <Button Classes="Flat"
              Padding="8"
              MinHeight="48"
              ToolTip.Tip="{loc:Loc Back}"
              AutomationProperties.Name="{loc:Loc Back}"
              Command="{Binding CloseCommand}">
        <avalonia:MaterialIcon Kind="ArrowLeft" Width="24" Height="24" />
      </Button>
      <TextBlock Text="{loc:Loc SearchPageTitle}" Classes="PageTitle" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Search box -->
    <TextBox Grid.Row="1"
             Margin="16,8,16,0"
             Text="{Binding SearchQuery, Mode=TwoWay}"
             PlaceholderText="{loc:Loc SearchPlaceholder}"
             wpf:TextFieldAssist.Label="{loc:Loc SearchPlaceholder}"
             UseFloatingPlaceholder="True"
             MinHeight="48" />

    <ScrollViewer Grid.Row="2" Classes="PageContent" Margin="16,8,16,0">
      <StackPanel>
        <!-- Loading indicator -->
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Margin="0,8" />

        <!-- Initial prompt (before any search) -->
        <TextBlock Text="{loc:Loc SearchInitialPrompt}"
                   Classes="EmptyState"
                   IsVisible="{Binding !HasSearched}" />

        <!-- No results -->
        <TextBlock Text="{loc:Loc SearchNoResults}"
                   Classes="EmptyState"
                   IsVisible="{Binding ShowNoResults}" />

        <!-- Results -->
        <ItemsControl ItemsSource="{Binding Results}"
                      Classes="CardList"
                      IsVisible="{Binding Results, Converter={x:Static converters:CollectionEmptyToBoolConverter.InstanceInverted}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SearchResultItem">
              <controls:Card Classes="ClickableCard">
                <Button Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).OpenResultCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding Name}"
                               Classes="Subtitle1"
                               FontWeight="Bold" />
                    <Border Grid.Row="0" Grid.Column="1" Classes="TypeBadge">
                      <TextBlock Text="{Binding Kind}" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding Subtitle}"
                               Classes="Body2"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource MaterialBodyLightBrush}"
                               IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </Grid>
                </Button>
              </controls:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
