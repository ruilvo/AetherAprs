<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:local="using:AetherAprs"
             xmlns:ext="using:AetherAprs.Extensions"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.PortsView"
             x:DataType="vm:PortsViewModel"
             d:DataContext="{x:Static local:DesignData.PortsViewModel}">

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="16,16,16,0">
      <TextBlock Text="{Binding Title}"
                 Classes="Headline5"
                 FontWeight="Bold" />
      <TextBlock Text="Manage your APRS ports"
                 Classes="Body2"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
    </StackPanel>

    <!-- Port list or empty state -->
    <ScrollViewer Grid.Row="1" Margin="16,16,16,80">
      <ItemsControl ItemsSource="{Binding PortItems}" HorizontalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PortItemViewModel">
            <controls:Card Padding="16" Margin="0" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <!-- Clickable area for edit -->
                <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                        Background="Transparent" BorderThickness="0" Padding="8"
                        Click="OnPortClicked"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Left">
                  <StackPanel>
                    <!-- Port name -->
                    <TextBlock Text="{Binding Name}"
                               Classes="Subheading"
                               FontWeight="SemiBold" />
                    
                    <!-- Status text -->
                    <TextBlock Text="{Binding StatusText}"
                               Classes="Caption"
                               Foreground="{DynamicResource MaterialSecondaryBodyBrush}"
                               Margin="0,4,0,0" />
                  </StackPanel>
                </Button>

                <!-- Type badge -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="{DynamicResource MaterialPrimaryBrush}"
                        CornerRadius="4"
                        Padding="8,4"
                        VerticalAlignment="Top">
                  <TextBlock Text="{Binding Type}"
                             Classes="Caption"
                             Foreground="White"
                             TextAlignment="Center" />
                </Border>

                <!-- Toggle switch (make it accessible with min height) -->
                <ToggleSwitch Grid.Row="0" Grid.Column="2"
                              IsChecked="{Binding IsEnabled}"
                              VerticalAlignment="Center"
                              MinHeight="40" />

                <!-- Delete button -->
                <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding $parent[ItemsControl].DataContext.DeletePortCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Delete port"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="8">
                  <avalonia:MaterialIcon Kind="Delete" Foreground="{DynamicResource MaterialErrorBrush}" />
                </Button>
              </Grid>
            </controls:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Floating Action Button -->
    <controls:FloatingButton Grid.Row="1"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,16,16"
                             x:Name="AddPortButton"
                             MinHeight="56"
                             MinWidth="56">
      <Viewbox Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch">
        <avalonia:MaterialIcon Kind="Plus" Width="24" Height="24" />
      </Viewbox>
    </controls:FloatingButton>
  </Grid>
</UserControl>
