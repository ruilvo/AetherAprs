<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:local="using:AetherAprs"
             xmlns:ext="using:AetherAprs.Extensions"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.PortsView"
             x:DataType="vm:PortsViewModel"
             d:DataContext="{x:Static local:DesignData.PortsViewModel}">

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="20,20,20,0">
      <TextBlock Text="{Binding Title}"
                 FontSize="24"
                 FontWeight="Bold" />
      <TextBlock Text="Manage your APRS ports"
                 FontSize="14"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
    </StackPanel>

    <!-- Port list or empty state -->
    <ScrollViewer Grid.Row="1" Margin="20,16,20,80">
      <ItemsControl ItemsSource="{Binding PortItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PortItemViewModel">
            <Border Background="{DynamicResource MaterialCardBackgroundBrush}"
                    CornerRadius="8"
                    Padding="16"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialCardBorderBrush}">
              <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                <!-- Port name -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding Name}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <!-- Type badge -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="{DynamicResource MaterialPrimaryBrush}"
                        CornerRadius="4"
                        Padding="8,2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding Type}"
                             FontSize="11"
                             Foreground="White" />
                </Border>

                <!-- Toggle switch -->
                <ToggleSwitch Grid.Row="0" Grid.Column="2"
                              IsChecked="{Binding IsEnabled}"
                              VerticalAlignment="Center" />

                <!-- Status text -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource MaterialSecondaryBodyBrush}"
                           Margin="0,4,0,0" />

                <!-- Delete button -->
                <Button Grid.Row="1" Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding $parent[ItemsControl].DataContext.DeletePortCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Delete port"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                  <avalonia:MaterialIcon Kind="Delete" Foreground="{DynamicResource MaterialErrorBrush}" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Floating Action Button -->
    <controls:FloatingButton Grid.Row="1"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,20,20"
                             x:Name="AddPortButton">
      <Viewbox Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch">
        <avalonia:MaterialIcon Kind="Plus" Width="24" Height="24" />
      </Viewbox>
    </controls:FloatingButton>
  </Grid>
</UserControl>
