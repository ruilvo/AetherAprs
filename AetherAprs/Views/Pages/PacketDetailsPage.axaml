<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels.Pages"
             xmlns:components="using:AetherAprs.ViewModels.Components"
             xmlns:local="using:AetherAprs"
             xmlns:ext="using:AetherAprs.Extensions"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:loc="using:AetherAprs.Localization"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.PacketDetailsPage"
             x:DataType="vm:PacketDetailsViewModel"
             d:DataContext="{x:Static local:DesignData.PacketDetailsViewModel}">

  <UserControl.Resources>
    <!-- One label/value row. Provenance and decoded detail share the shape, so both
         lists render through this template. -->
    <DataTemplate x:Key="PacketDetailFieldTemplate" x:DataType="components:PacketDetailField">
      <Grid ColumnDefinitions="Auto,*" Margin="0,1">
        <TextBlock Grid.Column="0"
                   Text="{Binding Label}"
                   Classes="Body2"
                   Opacity="0.7"
                   Margin="0,0,8,0" />
        <TextBlock Grid.Column="1"
                   Text="{Binding Value}"
                   Classes="Body2"
                   TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>

    <!-- A single packet: when it was received versus when the station sent it, where it
         came from, and every field the decoder recovered. -->
    <DataTemplate x:Key="PacketDetailCardTemplate" x:DataType="components:PacketDetailItemViewModel">
      <controls:Card Classes="StandardCard">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{Binding ReceivedAtText}"
                         Classes="Subtitle2"
                         FontWeight="Bold" />

              <!-- Protocol time is a separate row: it is what the station says it
                   sent, never what this station observed. -->
              <TextBlock Classes="Caption"
                         Opacity="0.7"
                         IsVisible="{Binding HasProtocolTime}">
                <Run Text="{loc:Loc PacketDetailProtocolTime}" />
                <Run Text=": " />
                <Run Text="{Binding ProtocolTimeText}" />
              </TextBlock>
            </StackPanel>

            <Border Grid.Column="1" Classes="TypeBadge" VerticalAlignment="Top">
              <TextBlock Text="{Binding PacketTypeText}" />
            </Border>
          </Grid>

          <!-- Origin: direction, port, path and receipt time. -->
          <Border BorderThickness="0,1,0,0"
                  BorderBrush="{DynamicResource MaterialDividerBrush}"
                  Padding="0,6,0,0">
            <ItemsControl ItemsSource="{Binding Provenance}"
                          ItemTemplate="{StaticResource PacketDetailFieldTemplate}" />
          </Border>

          <!-- Decoded payload. -->
          <ItemsControl ItemsSource="{Binding DecodedFields}"
                        ItemTemplate="{StaticResource PacketDetailFieldTemplate}"
                        IsVisible="{Binding HasDecodedFields}" />

          <TextBlock Text="{Binding UndecodedText}"
                     Classes="Body2"
                     Opacity="0.7"
                     TextWrapping="Wrap"
                     IsVisible="{Binding IsUndecoded}" />

          <!-- Raw provenance stays available on the detail card, not only on the Raw
               tab, so a reported frame can be matched without switching tabs. -->
          <StackPanel Spacing="2">
            <TextBlock Classes="Caption" Text="{loc:Loc RawLine}" Opacity="0.7" />
            <TextBlock Text="{Binding RawLine}" Classes="Body2" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="2" IsVisible="{Binding HasRawFrameHex}">
            <TextBlock Classes="Caption" Text="{loc:Loc RawFrameHex}" Opacity="0.7" />
            <TextBlock Text="{Binding RawFrameHex}" Classes="Body2" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </controls:Card>
    </DataTemplate>

    <!-- The Raw tab shows the exact line and frame with no decoded interpretation, so
         a frame can be compared byte for byte with an external log. -->
    <DataTemplate x:Key="PacketRawCardTemplate" x:DataType="components:PacketDetailItemViewModel">
      <controls:Card Classes="StandardCard">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ReceivedAtText}"
                     Classes="Subtitle2"
                     FontWeight="Bold" />

          <StackPanel Spacing="2">
            <TextBlock Classes="Caption" Text="{loc:Loc RawLine}" Opacity="0.7" />
            <TextBlock Text="{Binding RawLine}" Classes="Body2" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="2" IsVisible="{Binding HasRawFrameHex}">
            <TextBlock Classes="Caption" Text="{loc:Loc RawFrameHex}" Opacity="0.7" />
            <TextBlock Text="{Binding RawFrameHex}" Classes="Body2" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Port and path still belong to the raw view: they are part of the frame. -->
          <ItemsControl ItemsSource="{Binding Provenance}"
                        ItemTemplate="{StaticResource PacketDetailFieldTemplate}" />
        </StackPanel>
      </controls:Card>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Classes="PageHeader" Margin="16,16,16,0">
      <TextBlock Text="{Binding Title}" Classes="PageTitle" />
    </StackPanel>

    <!-- Content -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <!-- Distance / bearing header with radar -->
      <StackPanel Grid.Row="0" Margin="16,8,16,0" Spacing="8">
        <!-- Loading indicator -->
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Margin="0,4" />

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding SendMessageCommand}"
                  Classes="Flat">
            <Button.ContentTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{ext:MaterialIconGeometryExt Message}" />
                  <TextBlock Text="{loc:Loc SendMessage}" />
                </StackPanel>
              </DataTemplate>
            </Button.ContentTemplate>
          </Button>
        </StackPanel>

        <!-- Radar + distance/bearing -->
        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding HasDistance}">
          <Canvas Width="120" Height="120">
            <!-- Compass ring -->
            <Ellipse Width="120" Height="120"
                     Stroke="{DynamicResource MaterialDividerBrush}"
                     StrokeThickness="2" />
            <!-- Cardinal labels -->
            <TextBlock Text="{loc:Loc CompassNorth}" Classes="Caption" Canvas.Left="55" Canvas.Top="2" />
            <TextBlock Text="{loc:Loc CompassEast}" Classes="Caption" Canvas.Left="110" Canvas.Top="55" />
            <TextBlock Text="{loc:Loc CompassSouth}" Classes="Caption" Canvas.Left="55" Canvas.Top="112" />
            <TextBlock Text="{loc:Loc CompassWest}" Classes="Caption" Canvas.Left="3" Canvas.Top="55" />
            <!-- Needle: points north at 0 degrees, rotates to relative bearing.
                 Rotating a full-size panel around its center keeps the pivot at the
                 hub (60,60) instead of drifting off-center as a bare RotateTransform
                 with CenterX/CenterY offsets does. -->
            <Panel Width="120" Height="120" RenderTransformOrigin="50%,50%">
              <Panel.RenderTransform>
                <RotateTransform Angle="{Binding RelativeBearingDegrees}" />
              </Panel.RenderTransform>
              <Line StartPoint="60,60" EndPoint="60,14"
                    Stroke="{DynamicResource MaterialPrimaryMidBrush}"
                    StrokeThickness="3"
                    StrokeLineCap="Round" />
            </Panel>
            <!-- Center hub -->
            <Ellipse Canvas.Left="56" Canvas.Top="56" Width="8" Height="8"
                     Fill="{DynamicResource MaterialPrimaryMidBrush}" />
          </Canvas>
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock Classes="Body2">
              <Run Text="{loc:Loc Distance}" />
              <Run Text=": " />
              <Run Text="{Binding DistanceText}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Classes="Body2">
              <Run Text="{loc:Loc Bearing}" />
              <Run Text=": " />
              <Run Text="{Binding BearingText}" FontWeight="SemiBold" />
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- Tabs -->
      <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="8,8,8,0">
        <!-- History tab -->
        <TabItem Header="{loc:Loc PacketDetailsTabHistory}">
          <Grid>
            <ListBox x:Name="HistoryList"
                     Classes="PacketCardList"
                     ItemsSource="{Binding PacketDetails}"
                     ItemTemplate="{StaticResource PacketDetailCardTemplate}"
                     ScrollViewer.ScrollChanged="OnListScrollChanged">
            </ListBox>

            <!-- Empty state -->
            <TextBlock Text="{loc:Loc NoPacketsFound}"
                       Classes="EmptyState"
                       IsVisible="{Binding !HasPackets}" />
          </Grid>
        </TabItem>

        <!-- Position tab -->
        <TabItem Header="{loc:Loc PacketDetailsTabPosition}">
          <Grid>
            <ListBox x:Name="PositionList"
                     Classes="PacketCardList"
                     ItemsSource="{Binding PositionDetails}"
                     ItemTemplate="{StaticResource PacketDetailCardTemplate}"
                     ScrollViewer.ScrollChanged="OnListScrollChanged">
            </ListBox>

            <TextBlock Text="{loc:Loc NoPositionHistory}"
                       Classes="EmptyState"
                       IsVisible="{Binding !HasPositionHistory}" />
          </Grid>
        </TabItem>

        <!-- Raw tab -->
        <TabItem Header="{loc:Loc PacketDetailsTabRaw}">
          <Grid>
            <ListBox x:Name="RawList"
                     Classes="PacketCardList"
                     ItemsSource="{Binding PacketDetails}"
                     ItemTemplate="{StaticResource PacketRawCardTemplate}"
                     ScrollViewer.ScrollChanged="OnListScrollChanged">
            </ListBox>

            <TextBlock Text="{loc:Loc NoPacketsFound}"
                       Classes="EmptyState"
                       IsVisible="{Binding !HasPackets}" />
          </Grid>
        </TabItem>

        <!-- Telemetry tab -->
        <TabItem Header="{loc:Loc PacketDetailsTabTelemetry}">
          <Grid>
            <ListBox x:Name="TelemetryList"
                     Classes="PacketCardList"
                     ItemsSource="{Binding WeatherStatusTelemetryDetails}"
                     ItemTemplate="{StaticResource PacketDetailCardTemplate}"
                     ScrollViewer.ScrollChanged="OnListScrollChanged">
            </ListBox>

            <TextBlock Text="{loc:Loc NoWeatherTelemetry}"
                       Classes="EmptyState"
                       IsVisible="{Binding !HasWeatherStatusTelemetry}" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>

</UserControl>
