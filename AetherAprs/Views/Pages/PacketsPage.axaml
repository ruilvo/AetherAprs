<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels.Pages"
             xmlns:local="using:AetherAprs"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:loc="using:AetherAprs.Localization"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.PacketsPage"
             x:DataType="vm:PacketsViewModel"
             d:DataContext="{x:Static local:DesignData.PacketsViewModel}">

  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Classes="PageHeader" Margin="16,16,16,0">
      <TextBlock Text="{Binding Title}" Classes="PageTitle" />
    </StackPanel>

    <!-- Quick Actions -->
    <StackPanel Grid.Row="1" Spacing="8" Margin="16,8,16,0">
      <controls:Card Classes="ClickableCard">
        <Button Command="{Binding OpenObjectsCommand}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{loc:Loc ObjectsSectionEntry}"
                         Classes="Subtitle1"
                         FontWeight="Medium" />
              <TextBlock Text="{loc:Loc ObjectsSectionEntryDescription}"
                         Classes="Body2"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource MaterialBodyLightBrush}" />
            </StackPanel>
            <avalonia:MaterialIcon Grid.Column="1"
                                   Kind="ChevronRight"
                                   AutomationProperties.IsControlElementOverride="False"
                                   Width="24"
                                   Height="24"
                                   VerticalAlignment="Center" />
          </Grid>
        </Button>
      </controls:Card>

      <controls:Card Classes="ClickableCard">
        <Button Command="{Binding OpenSearchCommand}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{loc:Loc SearchSectionEntry}"
                         Classes="Subtitle1"
                         FontWeight="Medium" />
              <TextBlock Text="{loc:Loc SearchSectionEntryDescription}"
                         Classes="Body2"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource MaterialBodyLightBrush}" />
            </StackPanel>
            <avalonia:MaterialIcon Grid.Column="1"
                                   Kind="ChevronRight"
                                   AutomationProperties.IsControlElementOverride="False"
                                   Width="24"
                                   Height="24"
                                   VerticalAlignment="Center" />
          </Grid>
        </Button>
      </controls:Card>
    </StackPanel>

    <!-- Search box -->
    <TextBox Grid.Row="2"
             Margin="16,8,16,0"
             Text="{Binding SearchQuery, Mode=TwoWay}"
             wpf:TextFieldAssist.Label="{loc:Loc SearchPlaceholder}"
             UseFloatingPlaceholder="True"
             MinHeight="48" />

    <!-- Content -->
    <ScrollViewer Grid.Row="3" Classes="PageContent" x:Name="PacketsScroll">
      <StackPanel Classes="PageContainer">
        <!-- Loading indicator -->
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Margin="0,8" />

        <!-- Packet cards -->
        <ItemsControl ItemsSource="{Binding Packets}" Classes="CardList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PacketSummary">
              <controls:Card Classes="ClickableCard">
                <Button Command="{Binding $parent[UserControl].((vm:PacketsViewModel)DataContext).OpenPacketDetailsCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <!-- Callsign / object name -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding Source}"
                               Classes="Subtitle1"
                               FontWeight="Bold" />

                    <!-- Packet type badge -->
                    <Border Grid.Row="0" Grid.Column="1" Classes="TypeBadge">
                      <TextBlock Text="{Binding PacketType}" />
                    </Border>

                    <!-- Preview -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding Preview}"
                               Classes="Body2"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Opacity="0.7" />

                    <!-- Timestamp -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding ReceivedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                               Classes="Caption"
                               Margin="0,4,0,0"
                               Opacity="0.5" />
                  </Grid>
                </Button>
              </controls:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty states -->
        <TextBlock Text="{loc:Loc NoPacketsReceivedYet}"
                   Classes="EmptyState"
                   IsVisible="{Binding !HasAnyPackets}" />
        <TextBlock Text="{loc:Loc NoPacketsFound}"
                   Classes="EmptyState"
                   IsVisible="{Binding HasNoVisiblePackets}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>

</UserControl>
