<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels.Pages"
             xmlns:local="using:AetherAprs"
             xmlns:loc="using:AetherAprs.Localization"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
              xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
              xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
              xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.HomePage"
             x:DataType="vm:HomeViewModel"
             d:DataContext="{x:Static local:DesignData.HomeViewModel}">

    <Grid RowDefinitions="*" ColumnDefinitions="*">
        <mapsui:MapControl x:Name="MapControl"
                           Grid.Row="0" Grid.Column="0"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />

        <Border Grid.Row="0"
                Margin="12"
                Padding="12"
                VerticalAlignment="Top"
                IsVisible="{Binding HasPermissionWarning}"
                Background="{DynamicResource MaterialValidationErrorBrush}"
                CornerRadius="8">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding PermissionWarningText}"
                           TextWrapping="Wrap"
                           Foreground="White" />
                <Button Content="{loc:Loc PermissionOpenSettingsAction}"
                        IsVisible="{Binding CanOpenPermissionSettings}"
                        Command="{Binding OpenPermissionSettingsCommand}"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- The beacon outcome and the manual send live together: without a visible
             status, a suppressed or failed beacon looked like nothing happened. -->
        <Border Grid.Row="0"
                Margin="12"
                Padding="12"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                IsVisible="{Binding BeaconStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource MaterialBackgroundBrush}"
                CornerRadius="8">
            <StackPanel Spacing="8" MaxWidth="320">
                <TextBlock Text="{loc:Loc BeaconStatusLabel}"
                           Classes="Caption" />
                <TextBlock Text="{Binding BeaconStatus}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Spacing="8">
            <controls:FloatingButton MinHeight="56"
                                     MinWidth="56"
                                     automation:AutomationProperties.Name="{loc:Loc SendBeaconAction}"
                                     ToolTip.Tip="{loc:Loc SendBeaconAction}"
                                     Command="{Binding SendManualBeaconCommand}">
                <Viewbox Width="24" Height="24">
                    <avalonia:MaterialIcon Kind="Send" Width="24" Height="24" />
                </Viewbox>
            </controls:FloatingButton>
            <controls:FloatingButton MinHeight="56"
                                      MinWidth="56"
                                      automation:AutomationProperties.Name="{loc:Loc CenterOnMyLocationTooltip}"
                                     ToolTip.Tip="{loc:Loc CenterOnMyLocationTooltip}"
                                     Command="{Binding Map.CenterOnUserCommand}">
                <Viewbox Width="24" Height="24">
                    <avalonia:MaterialIcon Kind="CrosshairsGps" Width="24" Height="24" />
                </Viewbox>
            </controls:FloatingButton>
        </StackPanel>
    </Grid>
</UserControl>
