<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:messaging="using:AetherAprs.Models.Messaging"
             xmlns:local="using:AetherAprs"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.MessagesView"
             x:DataType="vm:MessagesViewModel"
             d:DataContext="{x:Static local:DesignData.MessagesViewModel}">

  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="8" Margin="16,16,16,0">
      <TextBlock Text="{Binding Title}"
                 Classes="Headline5"
                 FontWeight="Bold" />
      <TextBlock Text="APRS message conversations"
                 Classes="Body2"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="16,16,16,80">
      <ItemsControl ItemsSource="{Binding Conversations}" x:Name="ConversationsList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="messaging:ConversationThread">
            <controls:Card Padding="0">
              <Button Classes="Flat"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="12"
                      Tag="{Binding}"
                      Click="OnConversationClick">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding PeerDisplay}"
                             Classes="Subtitle1"
                             FontWeight="Bold" />
                  <TextBlock Text="{Binding Preview}"
                             Classes="Body2"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
                </StackPanel>
              </Button>
            </controls:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <controls:FloatingButton Grid.Row="1"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,16,16"
                             MinHeight="56"
                             MinWidth="56"
                             x:Name="NewMessageButton">
      <Viewbox Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch">
        <avalonia:MaterialIcon Kind="Plus" Width="24" Height="24" />
      </Viewbox>
    </controls:FloatingButton>
  </Grid>
</UserControl>
