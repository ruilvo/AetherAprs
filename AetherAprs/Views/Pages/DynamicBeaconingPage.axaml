<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels.Pages"
             xmlns:models="using:AetherAprs.Models"
             xmlns:local="using:AetherAprs"
             xmlns:loc="using:AetherAprs.Localization"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="1000"
             x:Class="AetherAprs.Views.Pages.DynamicBeaconingPage"
             x:DataType="vm:DynamicBeaconingViewModel"
             d:DataContext="{x:Static local:DesignData.DynamicBeaconingViewModel}">
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" Classes="PageContent">
      <StackPanel Classes="SettingsContainer">

        <!-- Header -->
        <StackPanel Classes="PageHeader">
          <TextBlock Classes="PageTitle"
                     Text="{loc:Loc DynamicBeaconing}" />
          <TextBlock Classes="PageSubtitle"
                     Text="{loc:Loc DynamicBeaconingDescriptionLong}" />
        </StackPanel>

        <!-- Active Mode Selection -->
        <StackPanel Spacing="12">
          <TextBlock Classes="SectionTitle"
                     Text="{loc:Loc ActiveBeaconMode}" />

          <ComboBox Theme="{StaticResource MaterialOutlineComboBox}"
                    assists:ComboBoxAssist.Label="{loc:Loc Mode}"
                    x:CompileBindings="False"
                    SelectedValue="{Binding ActiveMode, Mode=TwoWay}"
                    SelectedValueBinding="{Binding Tag}">
            <ComboBoxItem Content="{loc:Loc WalkPedestrian}"
                          Tag="{x:Static models:DynamicBeaconMode.Walk}" />
            <ComboBoxItem Content="{loc:Loc DriveVehicular}"
                          Tag="{x:Static models:DynamicBeaconMode.Drive}" />
            <ComboBoxItem Content="{loc:Loc Custom}"
                          Tag="{x:Static models:DynamicBeaconMode.Custom}" />
          </ComboBox>
        </StackPanel>

        <!-- Walk Configuration -->
        <controls:Card Classes="StandardCard">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4" Orientation="Horizontal">
                    <TextBlock Classes="Subtitle1" Text="{loc:Loc WalkMode}" VerticalAlignment="Center" />
              <Button Content="{loc:Loc ResetToDefault}"
                      Command="{Binding ResetWalkToDefaultCommand}"
                      Padding="8,4"
                      MinHeight="48"
                      VerticalAlignment="Center"
                      Theme="{StaticResource MaterialOutlineButton}"
                      Classes="Outline" />
            </StackPanel>

            <TextBlock Classes="Caption"
                       Text="{loc:Loc WalkModeDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc SlowSpeedIntervalStationary}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding WalkConfiguration.SlowIntervalSeconds}"
                                 Minimum="60"
                                 Maximum="3600"
                                 Increment="60" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Seconds}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc NormalSpeedInterval}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding WalkConfiguration.NormalIntervalSeconds}"
                                 Minimum="60"
                                 Maximum="1800"
                                 Increment="60" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Seconds}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc FastSpeedIntervalMovingQuickly}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding WalkConfiguration.FastIntervalSeconds}"
                                 Minimum="30"
                                 Maximum="600"
                                 Increment="30" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Seconds}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc SlowSpeedThreshold}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding WalkConfiguration.SlowSpeedThresholdKmh}"
                                 Minimum="0.5"
                                 Maximum="30"
                                 Increment="0.5"
                                 FormatString="F1" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc KilometersPerHour}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc FastSpeedThreshold}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding WalkConfiguration.FastSpeedThresholdKmh}"
                                 Minimum="5"
                                 Maximum="100"
                                 Increment="5"
                                 FormatString="F1" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc KilometersPerHour}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc CourseChangeThreshold}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding WalkConfiguration.CourseChangeThresholdDegrees}"
                                 Minimum="0"
                                 Maximum="180"
                                 Increment="5" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Degrees}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc MinimumDistance}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding WalkConfiguration.MinimumDistanceMeters}"
                                 Minimum="10"
                                 Maximum="500"
                                 Increment="10" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Meters}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <TextBox Text="{Binding WalkConfiguration.BeaconComment}"
                       PlaceholderText="{loc:Loc OptionalBeaconComment}"
                       assists:TextFieldAssist.Label="{loc:Loc BeaconComment}"
                       UseFloatingPlaceholder="True" />
            </StackPanel>
          </StackPanel>
        </controls:Card>

        <!-- Drive Configuration -->
        <controls:Card Classes="StandardCard">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4" Orientation="Horizontal">
                    <TextBlock Classes="Subtitle1" Text="{loc:Loc DriveMode}" VerticalAlignment="Center" />
              <Button Content="{loc:Loc ResetToDefault}"
                      Command="{Binding ResetDriveToDefaultCommand}"
                      Padding="8,4"
                      MinHeight="48"
                      VerticalAlignment="Center"
                      Theme="{StaticResource MaterialOutlineButton}"
                      Classes="Outline" />
            </StackPanel>

            <TextBlock Classes="Caption"
                       Text="{loc:Loc DriveModeDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc SlowSpeedIntervalStationary}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding DriveConfiguration.SlowIntervalSeconds}"
                                 Minimum="60"
                                 Maximum="3600"
                                 Increment="60" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Seconds}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc NormalSpeedInterval}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding DriveConfiguration.NormalIntervalSeconds}"
                                 Minimum="30"
                                 Maximum="1800"
                                 Increment="30" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Seconds}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc FastSpeedIntervalHighway}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding DriveConfiguration.FastIntervalSeconds}"
                                 Minimum="10"
                                 Maximum="300"
                                 Increment="10" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Seconds}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc SlowSpeedThreshold}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding DriveConfiguration.SlowSpeedThresholdKmh}"
                                 Minimum="1"
                                 Maximum="50"
                                 Increment="1"
                                 FormatString="F1" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc KilometersPerHour}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc FastSpeedThreshold}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding DriveConfiguration.FastSpeedThresholdKmh}"
                                 Minimum="20"
                                 Maximum="200"
                                 Increment="10"
                                 FormatString="F1" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc KilometersPerHour}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc CourseChangeThreshold}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding DriveConfiguration.CourseChangeThresholdDegrees}"
                                 Minimum="0"
                                 Maximum="180"
                                 Increment="5" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Degrees}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc MinimumDistance}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding DriveConfiguration.MinimumDistanceMeters}"
                                 Minimum="20"
                                 Maximum="500"
                                 Increment="20" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Meters}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <TextBox Text="{Binding DriveConfiguration.BeaconComment}"
                       PlaceholderText="{loc:Loc OptionalBeaconComment}"
                       assists:TextFieldAssist.Label="{loc:Loc BeaconComment}"
                       UseFloatingPlaceholder="True" />
            </StackPanel>
          </StackPanel>
        </controls:Card>

        <!-- Custom Configuration -->
        <controls:Card Classes="StandardCard">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4" Orientation="Horizontal">
                    <TextBlock Classes="Subtitle1" Text="{loc:Loc CustomMode}" VerticalAlignment="Center" />
              <Button Content="{loc:Loc ResetToDefault}"
                      Command="{Binding ResetCustomToDefaultCommand}"
                      Padding="8,4"
                      MinHeight="48"
                      VerticalAlignment="Center"
                      Theme="{StaticResource MaterialOutlineButton}"
                      Classes="Outline" />
            </StackPanel>

            <TextBlock Classes="Caption"
                       Text="{loc:Loc CustomModeDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />

            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc SlowSpeedIntervalStationary}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding CustomConfiguration.SlowIntervalSeconds}"
                                 Minimum="60"
                                 Maximum="3600"
                                 Increment="60" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Seconds}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc NormalSpeedInterval}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding CustomConfiguration.NormalIntervalSeconds}"
                                 Minimum="30"
                                 Maximum="1800"
                                 Increment="30" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Seconds}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc FastSpeedInterval}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding CustomConfiguration.FastIntervalSeconds}"
                                 Minimum="10"
                                 Maximum="600"
                                 Increment="10" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Seconds}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc SlowSpeedThreshold}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding CustomConfiguration.SlowSpeedThresholdKmh}"
                                 Minimum="0.5"
                                 Maximum="50"
                                 Increment="0.5"
                                 FormatString="F1" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc KilometersPerHour}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc FastSpeedThreshold}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding CustomConfiguration.FastSpeedThresholdKmh}"
                                 Minimum="5"
                                 Maximum="200"
                                 Increment="5"
                                 FormatString="F1" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc KilometersPerHour}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc CourseChangeThresholdDisabled}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding CustomConfiguration.CourseChangeThresholdDegrees}"
                                 Minimum="0"
                                 Maximum="180"
                                 Increment="5" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Degrees}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="Body2" Text="{loc:Loc MinimumDistance}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0"
                                 Value="{Binding CustomConfiguration.MinimumDistanceMeters}"
                                 Minimum="10"
                                 Maximum="500"
                                 Increment="10" />
                  <TextBlock Grid.Column="1" Text="{loc:Loc Meters}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>

              <TextBox Text="{Binding CustomConfiguration.BeaconComment}"
                       PlaceholderText="{loc:Loc OptionalBeaconComment}"
                       assists:TextFieldAssist.Label="{loc:Loc BeaconComment}"
                       UseFloatingPlaceholder="True" />
            </StackPanel>
          </StackPanel>
        </controls:Card>

      </StackPanel>
    </ScrollViewer>

    <!-- Close Button (sticky at bottom) -->
    <Border Grid.Row="1"
            Background="{DynamicResource MaterialBackgroundBrush}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource MaterialDividerBrush}"
            Padding="16">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="{loc:Loc Close}"
                Command="{Binding CloseCommand}"
                MinWidth="80"
                MinHeight="48" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
