<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels.Pages"
             xmlns:messaging="using:AetherAprs.Models.Messaging"
             xmlns:local="using:AetherAprs"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:loc="using:AetherAprs.Localization"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.Pages.MessagesPage"
             x:DataType="vm:MessagesViewModel"
             d:DataContext="{x:Static local:DesignData.MessagesViewModel}">

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Classes="PageHeader" Margin="16,16,16,0">
      <TextBlock Text="{Binding Title}" Classes="PageTitle" />
      <TextBlock Text="{loc:Loc AprsMessageConversations}" Classes="PageSubtitle" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Classes="PageContent">
      <StackPanel>
        <TextBlock Text="{loc:Loc MessagesEmptyState}"
                   Classes="EmptyState"
                   IsVisible="{Binding !HasConversations}" />
        <ItemsControl ItemsSource="{Binding Conversations}"
                      x:Name="ConversationsList"
                      Classes="CardList"
                      Margin="16,0"
                      IsVisible="{Binding HasConversations}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="messaging:ConversationThread">
              <controls:Card Classes="ClickableCard">
                <Button Command="{Binding $parent[UserControl].((vm:MessagesViewModel)DataContext).OpenConversationCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding PeerDisplay}"
                               Classes="Subtitle1" />
                    <TextBlock Text="{Binding Preview}"
                               Classes="Body2"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MaterialBodyLightBrush}" />
                  </StackPanel>
                </Button>
              </controls:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Bulletins Section -->
        <StackPanel Spacing="8" Margin="16,16,16,0">
          <controls:Card Classes="ClickableCard">
            <Button Command="{Binding OpenBulletinsCommand}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="{loc:Loc BulletinsSectionEntry}"
                             Classes="Subtitle1"
                             FontWeight="Medium" />
                  <TextBlock Text="{loc:Loc BulletinsSectionEntryDescription}"
                             Classes="Body2"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource MaterialBodyLightBrush}" />
                </StackPanel>
                <avalonia:MaterialIcon Grid.Column="1"
                                       Kind="ChevronRight"
                                       AutomationProperties.IsControlElementOverride="False"
                                       Width="24"
                                       Height="24"
                                       VerticalAlignment="Center" />
              </Grid>
            </Button>
          </controls:Card>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <controls:FloatingButton Grid.Row="1"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0,0,16,16"
                             MinHeight="56"
                             MinWidth="56"
                             x:Name="NewMessageButton"
                             automation:AutomationProperties.Name="{loc:Loc NewMessage}"
                             Command="{Binding NewMessageCommand}">
      <Viewbox Width="24" Height="24">
        <avalonia:MaterialIcon Kind="Plus" Width="24" Height="24" />
      </Viewbox>
    </controls:FloatingButton>
  </Grid>
</UserControl>
