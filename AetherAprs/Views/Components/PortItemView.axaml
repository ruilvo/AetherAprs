<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="100"
             x:Class="AetherAprs.Views.Components.PortItemView"
             x:DataType="vm:PortItemViewModel">
  
  <controls:Card Padding="16" Margin="0" HorizontalAlignment="Stretch">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
      <!-- Clickable area for edit -->
      <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
              Background="Transparent" BorderThickness="0" Padding="8"
              Click="OnPortClicked"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Left">
        <StackPanel>
          <!-- Port name -->
          <TextBlock Text="{Binding Name}"
                     Classes="Headline6" />
          
          <!-- Status text -->
          <TextBlock Text="{Binding StatusText}"
                     Classes="Caption"
                     Foreground="{DynamicResource MaterialSecondaryBodyBrush}"
                     Margin="0,4,0,0" />
        </StackPanel>
      </Button>

      <!-- Type badge -->
      <Border Grid.Row="0" Grid.Column="1"
              Background="{DynamicResource MaterialPrimaryBrush}"
              CornerRadius="4"
              Padding="8,4"
              VerticalAlignment="Top">
        <TextBlock Text="{Binding TypeName}"
                   Classes="Caption"
                   Foreground="White"
                   TextAlignment="Center" />
      </Border>

      <!-- Toggle switch (make it accessible with min height) -->
      <ToggleSwitch Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                    IsChecked="{Binding IsEnabled}"
                    VerticalAlignment="Center"
                    MinHeight="48" />

      <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="4">
        <!-- Show on map -->
        <Button Background="Transparent"
                BorderThickness="0"
                Padding="8"
                VerticalAlignment="Center"
                ToolTip.Tip="Show on map"
                Click="OnShowOnMapClicked">
          <Panel>
            <avalonia:MaterialIcon Kind="Map"
                                   Width="24"
                                   Height="24"
                                   IsVisible="{Binding ShowOnMap}"
                                   Foreground="{DynamicResource MaterialPrimaryBrush}" />
            <avalonia:MaterialIcon Kind="MapOutline"
                                   Width="24"
                                   Height="24"
                                   IsVisible="{Binding !ShowOnMap}"
                                   Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
          </Panel>
        </Button>

        <!-- Delete button -->
        <Button Background="Transparent"
                BorderThickness="0"
                Click="OnDeleteClicked"
                ToolTip.Tip="Delete port"
                VerticalAlignment="Center"
                Padding="8">
          <avalonia:MaterialIcon Kind="Delete" Width="24" Height="24" Foreground="{DynamicResource MaterialErrorBrush}" />
        </Button>
      </StackPanel>
    </Grid>
  </controls:Card>
</UserControl>
