<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels.Components"
             xmlns:loc="using:AetherAprs.Localization"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             mc:Ignorable="d" d:DesignWidth="400"
             x:Class="AetherAprs.Views.Components.AprsIsFilterBuilderComponent"
             x:DataType="vm:AprsIsFilterBuilderViewModel">
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="40" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">
    <TextBlock Classes="Subtitle2"
               Text="{loc:Loc FilterOptional}"
               Foreground="{DynamicResource MaterialPrimaryBrush}" />

    <!-- Range filter (r/lat/lon/dist) -->
    <StackPanel Spacing="4">
      <TextBlock Classes="Body2" Text="{loc:Loc FilterRangeSection}" />
      <TextBox Text="{Binding RangeLatitude}"
               wpf:TextFieldAssist.Label="{loc:Loc FilterLatitude}"
               UseFloatingPlaceholder="True" />
      <TextBox Text="{Binding RangeLongitude}"
               wpf:TextFieldAssist.Label="{loc:Loc FilterLongitude}"
               UseFloatingPlaceholder="True" />
      <TextBox Text="{Binding RangeDistanceKm}"
               wpf:TextFieldAssist.Label="{loc:Loc FilterDistanceKm}"
               UseFloatingPlaceholder="True" />
    </StackPanel>

    <!-- Prefix filter (p/aa/bb) -->
    <StackPanel Spacing="4">
      <TextBlock Classes="Body2" Text="{loc:Loc FilterPrefixSection}" />
      <TextBox Text="{Binding Prefixes}"
               wpf:TextFieldAssist.Label="{loc:Loc FilterPrefixes}"
               UseFloatingPlaceholder="True" />
    </StackPanel>

    <!-- Buddy filter (b/call) -->
    <StackPanel Spacing="4">
      <TextBlock Classes="Body2" Text="{loc:Loc FilterBuddySection}" />
      <TextBox Text="{Binding Buddies}"
               wpf:TextFieldAssist.Label="{loc:Loc FilterBuddies}"
               UseFloatingPlaceholder="True" />
    </StackPanel>

    <!-- Type filter (t/...) -->
    <StackPanel Spacing="4">
      <TextBlock Classes="Body2" Text="{loc:Loc FilterTypeSection}" />
      <WrapPanel>
        <CheckBox Content="{loc:Loc PacketTypePosition}" IsChecked="{Binding IncludePosition}" />
        <CheckBox Content="{loc:Loc PacketTypeObject}" IsChecked="{Binding IncludeObject}" />
        <CheckBox Content="{loc:Loc PacketTypeItem}" IsChecked="{Binding IncludeItem}" />
        <CheckBox Content="{loc:Loc PacketTypeMessage}" IsChecked="{Binding IncludeMessage}" />
        <CheckBox Content="{loc:Loc PacketTypeQuery}" IsChecked="{Binding IncludeQuery}" />
        <CheckBox Content="{loc:Loc PacketTypeStatus}" IsChecked="{Binding IncludeStatus}" />
        <CheckBox Content="{loc:Loc PacketTypeTelemetry}" IsChecked="{Binding IncludeTelemetry}" />
        <CheckBox Content="{loc:Loc PacketTypeUserDefined}" IsChecked="{Binding IncludeUserDefined}" />
        <CheckBox Content="{loc:Loc PacketTypeNws}" IsChecked="{Binding IncludeNws}" />
        <CheckBox Content="{loc:Loc PacketTypeWeather}" IsChecked="{Binding IncludeWeather}" />
      </WrapPanel>
    </StackPanel>

    <!-- Area filter (a/latN/lonW/latS/lonE) -->
    <StackPanel Spacing="4">
      <TextBlock Classes="Body2" Text="{loc:Loc FilterAreaSection}" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <TextBox Grid.Column="0" Text="{Binding AreaNorth}"
                 wpf:TextFieldAssist.Label="{loc:Loc FilterNorthLatitude}"
                 UseFloatingPlaceholder="True" />
        <TextBox Grid.Column="1" Text="{Binding AreaWest}"
                 wpf:TextFieldAssist.Label="{loc:Loc FilterWestLongitude}"
                 UseFloatingPlaceholder="True" />
      </Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <TextBox Grid.Column="0" Text="{Binding AreaSouth}"
                 wpf:TextFieldAssist.Label="{loc:Loc FilterSouthLatitude}"
                 UseFloatingPlaceholder="True" />
        <TextBox Grid.Column="1" Text="{Binding AreaEast}"
                 wpf:TextFieldAssist.Label="{loc:Loc FilterEastLongitude}"
                 UseFloatingPlaceholder="True" />
      </Grid>
    </StackPanel>

    <!-- My-range filter (m/dist) -->
    <StackPanel Spacing="4">
      <TextBlock Classes="Body2" Text="{loc:Loc FilterMyRangeSection}" />
      <TextBox Text="{Binding MyRangeKm}"
               wpf:TextFieldAssist.Label="{loc:Loc FilterDistanceKm}"
               UseFloatingPlaceholder="True" />
    </StackPanel>

    <!-- Live preview of the generated filter string -->
    <StackPanel Spacing="4">
      <TextBlock Classes="Caption"
                 Text="{loc:Loc FilterPreview}"
                 Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
      <TextBox Text="{Binding Filter}"
               IsReadOnly="True"
               Classes="Outline" />
    </StackPanel>
  </StackPanel>
</UserControl>
