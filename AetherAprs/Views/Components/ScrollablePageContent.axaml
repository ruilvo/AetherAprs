<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/avaloniaui"
             xmlns:behaviors="using:AetherAprs.Behaviors"
             mc:Ignorable="d"
             x:Class="AetherAprs.Views.Components.ScrollablePageContent">
  <ScrollViewer Classes="PageContent">
    <i:Interaction.Behaviors>
      <behaviors:ScrollToFocusedControlBehavior />
    </i:Interaction.Behaviors>
    <ContentPresenter Content="{Binding $parent[UserControl].Content, RelativeSource={RelativeSource Self}}" />
  </ScrollViewer>
</UserControl>
