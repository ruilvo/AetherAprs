<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             x:Class="AetherAprs.Views.Components.AprsSymbolPickerView"
             x:Name="Root">
    <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <avalonia:MaterialIcon Kind="MapMarker"
                                   Width="20"
                                   Height="20"
                                   Foreground="{DynamicResource MaterialPrimaryBrush}" />
            <TextBlock Classes="Subheading"
                       Text="APRS Symbol"
                       Foreground="{DynamicResource MaterialPrimaryBrush}" />
        </StackPanel>

        <Grid ColumnDefinitions="64,64,Auto"
              ColumnSpacing="12"
              VerticalAlignment="Center">
            <TextBox Grid.Column="0"
                     Text="{Binding TableCharacter, ElementName=Root, Mode=TwoWay}"
                     IsEnabled="{Binding IsEditable, ElementName=Root}"
                     MaxLength="1"
                     HorizontalContentAlignment="Center"
                     PlaceholderText="/"
                     wpf:TextFieldAssist.Label="Table"
                     UseFloatingPlaceholder="True" />
            <TextBox Grid.Column="1"
                     Text="{Binding CodeCharacter, ElementName=Root, Mode=TwoWay}"
                     IsEnabled="{Binding IsEditable, ElementName=Root}"
                     MaxLength="1"
                     HorizontalContentAlignment="Center"
                     PlaceholderText="["
                     wpf:TextFieldAssist.Label="Code"
                     UseFloatingPlaceholder="True" />
            <Border Grid.Column="2"
                    Width="64"
                    Height="64"
                    Padding="4"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    Background="{DynamicResource MaterialCardBackgroundBrush}">
                <Image Source="{Binding SymbolPreview, ElementName=Root}"
                       Stretch="Uniform" />
            </Border>
        </Grid>

        <CheckBox Content="Use default station symbol"
                  IsVisible="{Binding ShowInheritOption, ElementName=Root}"
                  IsChecked="{Binding UseDefault, ElementName=Root, Mode=TwoWay}"
                  MinHeight="40"
                  VerticalContentAlignment="Center" />

        <ComboBox ItemsSource="{Binding SymbolOptions, ElementName=Root}"
                  SelectedItem="{Binding SelectedSymbolOption, ElementName=Root, Mode=TwoWay}"
                  IsEnabled="{Binding IsEditable, ElementName=Root}"
                  Theme="{StaticResource MaterialOutlineComboBox}"
                  wpf:ComboBoxAssist.Label="Choose a symbol">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AprsSymbolOption">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="(" Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
                        <TextBlock Text="{Binding TableCharacter}" Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
                        <TextBlock Text="{Binding CodeCharacter}" Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
                        <TextBlock Text=")" Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Enter the APRS table and code characters."
                   Classes="Caption"
                   Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
    </StackPanel>
</UserControl>
