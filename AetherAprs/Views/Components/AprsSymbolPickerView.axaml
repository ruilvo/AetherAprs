<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherAprs.ViewModels.Components"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:AetherAprs.Localization"
             x:Class="AetherAprs.Views.Components.AprsSymbolPickerView"
             x:DataType="vm:AprsSymbolPickerViewModel"
             x:Name="Root">
    <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="Headline6"
                       Text="{loc:Loc AprsSymbol}"
                       Foreground="{DynamicResource MaterialPrimaryBrush}" />
        </StackPanel>

        <!-- Symbol Selection Buttons -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <!-- Base Symbol Button -->
            <Button Grid.Column="0"
                    Classes="Outline"
                    Height="80"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding OpenBaseSymbolSelectorCommand}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Border Width="48"
                            Height="48"
                            Padding="2"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDividerBrush}">
                        <Image Source="{Binding BaseSymbolPreview}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{loc:Loc BaseSymbol}"
                               Classes="Caption"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
                </StackPanel>
            </Button>

            <!-- Overlay Button -->
            <Button Grid.Column="1"
                    Classes="Outline"
                    Height="80"
                    HorizontalContentAlignment="Stretch"
                    IsEnabled="{Binding IsOverlayEnabled}"
                    Command="{Binding OpenOverlaySelectorCommand}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Border Width="48"
                            Height="48"
                            Padding="2"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDividerBrush}">
                        <Image Source="{Binding OverlayPreview}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{loc:Loc Overlay}"
                               Classes="Caption"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Final Symbol Preview -->
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc Result}"
                       Classes="Caption"
                       Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
            <Border Width="64"
                    Height="64"
                    Padding="4"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    Background="{DynamicResource MaterialCardBackgroundBrush}"
                    HorizontalAlignment="Left">
                <Image Source="{Binding FinalSymbolPreview}"
                       Stretch="Uniform" />
            </Border>
        </StackPanel>

        <TextBlock Text="{loc:Loc SymbolPickerDescription}"
                   Classes="Caption"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
    </StackPanel>
</UserControl>
