<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:pages="using:AetherAprs.ViewModels.Pages"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             x:Class="AetherAprs.Views.Components.AprsSymbolPickerView"
             x:Name="Root">
    <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <avalonia:MaterialIcon Kind="MapMarker"
                                   Width="20"
                                   Height="20"
                                   Foreground="{DynamicResource MaterialPrimaryBrush}" />
            <TextBlock Classes="Headline6"
                       Text="APRS Symbol"
                       Foreground="{DynamicResource MaterialPrimaryBrush}" />
        </StackPanel>

        <!-- Symbol Selection Buttons -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <!-- Base Symbol Button -->
            <Button Grid.Column="0"
                    Classes="Outline"
                    Height="80"
                    HorizontalContentAlignment="Stretch"
                    Click="OnBaseSymbolButtonClick">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Border Width="48"
                            Height="48"
                            Padding="2"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDividerBrush}">
                        <Image Source="{Binding BaseSymbolPreview, ElementName=Root}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="Base Symbol"
                               Classes="Caption"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
                </StackPanel>
            </Button>

            <!-- Overlay Button -->
            <Button Grid.Column="1"
                    Classes="Outline"
                    Height="80"
                    HorizontalContentAlignment="Stretch"
                    IsEnabled="{Binding IsOverlayEnabled, ElementName=Root}"
                    Click="OnOverlayButtonClick">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Border Width="48"
                            Height="48"
                            Padding="2"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDividerBrush}">
                        <Image Source="{Binding OverlayPreview, ElementName=Root}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="Overlay"
                               Classes="Caption"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Final Symbol Preview -->
        <StackPanel Spacing="4">
            <TextBlock Text="Result"
                       Classes="Caption"
                       Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
            <Border Width="64"
                    Height="64"
                    Padding="4"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    Background="{DynamicResource MaterialCardBackgroundBrush}"
                    HorizontalAlignment="Left">
                <Image Source="{Binding FinalSymbolPreview, ElementName=Root}"
                       Stretch="Uniform" />
            </Border>
        </StackPanel>

        <TextBlock Text="Select a base symbol from the primary or alternate table. If you select from the alternate table, you can also add an overlay character."
                   Classes="Caption"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MaterialSecondaryBodyBrush}" />
    </StackPanel>
</UserControl>
