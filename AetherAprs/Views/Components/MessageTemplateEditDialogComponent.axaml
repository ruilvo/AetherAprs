<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherAprs.ViewModels.Components"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:loc="using:AetherAprs.Localization"
             x:Class="AetherAprs.Views.Components.MessageTemplateEditDialogComponent"
             x:DataType="vm:MessageTemplateEditViewModel">
  <StackPanel Spacing="12" MinWidth="320" MaxWidth="480">

    <TextBlock Classes="Headline6"
               Text="{loc:Loc AddTemplate}"
               Foreground="{DynamicResource MaterialPrimaryBrush}"
               IsVisible="{Binding IsAddMode}" />

    <TextBlock Classes="Headline6"
               Text="{loc:Loc EditTemplate}"
               Foreground="{DynamicResource MaterialPrimaryBrush}"
               IsVisible="{Binding !IsAddMode}" />

    <StackPanel Spacing="4">
      <TextBox Text="{Binding Name}"
               wpf:TextFieldAssist.Label="{loc:Loc TemplateName}"
               UseFloatingPlaceholder="True" />
      <TextBlock Classes="Caption"
                 Foreground="{DynamicResource MaterialValidationErrorBrush}"
                 Text="{Binding NameError}"
                 IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBox Text="{Binding Destination}"
               wpf:TextFieldAssist.Label="{loc:Loc TemplateDestination}"
               UseFloatingPlaceholder="True" />
      <TextBlock Classes="Caption"
                 Foreground="{DynamicResource MaterialValidationErrorBrush}"
                 Text="{Binding DestinationError}"
                 IsVisible="{Binding DestinationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBox Text="{Binding Body}"
               wpf:TextFieldAssist.Label="{loc:Loc TemplateBody}"
               UseFloatingPlaceholder="True"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="100" />
      <TextBlock Classes="Caption"
                 Foreground="{DynamicResource MaterialValidationErrorBrush}"
                 Text="{Binding BodyError}"
                 IsVisible="{Binding BodyError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 TextWrapping="Wrap" />
      <TextBlock Classes="Caption"
                 Foreground="{DynamicResource MaterialSecondaryBodyBrush}"
                 Text="{loc:Loc TemplatePlaceholdersHint}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Classes="Flat"
              Content="{loc:Loc Cancel}"
              Click="OnCancelClick" />
      <Button Classes="Flat"
              Content="{loc:Loc Save}"
              Command="{Binding SaveCommand}"
              IsEnabled="{Binding CanSave}" />
    </StackPanel>
  </StackPanel>
</UserControl>
