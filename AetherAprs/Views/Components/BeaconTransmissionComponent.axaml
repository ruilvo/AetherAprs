<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:local="using:AetherAprs"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:loc="using:AetherAprs.Localization"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
             x:Class="AetherAprs.Views.Components.BeaconTransmissionComponent"
             x:DataType="vm:BeaconTransmissionViewModel"
             d:DataContext="{x:Static local:DesignData.BeaconTransmissionViewModel}">
    
    <controls:Card Padding="16" Margin="0">
        <StackPanel Spacing="12">
            <TextBlock Text="{loc:Loc BeaconTransmission}" 
                       Classes="Subtitle1"
                       Foreground="{DynamicResource MaterialPrimaryBrush}" />
            
            <TextBlock Text="{Binding BeaconStatus}" 
                       Classes="Body2"
                       TextWrapping="Wrap" />
            
            <StackPanel Spacing="8" 
                       IsVisible="{Binding LastBeaconDecision, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{loc:Loc LastDecision}" 
                           Classes="Subtitle2"
                           Foreground="{DynamicResource MaterialPrimaryBrush}" />
                
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{loc:Loc Speed}" Classes="Caption" />
                        <TextBlock Classes="Caption" FontWeight="SemiBold">
                            <Run Text="{Binding LastBeaconDecision.CurrentSpeedKmh, StringFormat={}{0:F1}}" />
                            <Run Text=" " />
                            <Run Text="{loc:Loc KilometersPerHour}" />
                        </TextBlock>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="8" 
                               IsVisible="{Binding LastBeaconDecision.CurrentCourseDegrees, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{loc:Loc Course}" Classes="Caption" />
                        <TextBlock Text="{Binding LastBeaconDecision.CurrentCourseDegrees, StringFormat={}{0:F0}°}" 
                                   Classes="Caption"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{loc:Loc Interval}" Classes="Caption" />
                        <TextBlock Text="{Binding LastBeaconDecision.ActiveIntervalSeconds, StringFormat={}{0}s}" 
                                   Classes="Caption"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    
                    <TextBlock Text="{Binding LastBeaconDecision.Reason}" 
                               Classes="Caption"
                               FontStyle="Italic"
                               Foreground="{DynamicResource MaterialSecondaryBodyBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </controls:Card>
</UserControl>
