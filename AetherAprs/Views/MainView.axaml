<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:local="using:AetherAprs"
             xmlns:ext="using:AetherAprs.Extensions"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.MainView"
             x:DataType="vm:MainViewModel"
             d:DataContext="{x:Static local:DesignData.MainViewModel}">
  
  <TabbedPage x:Name="MainTabbedPage" 
              TabPlacement="Bottom"
              SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

    <ContentPage Header="Home" Icon="{ext:MaterialIconGeometryExt Home}">
      <ContentControl Content="{Binding HomeViewModel}" />
    </ContentPage>

    <ContentPage Header="Settings" Icon="{ext:MaterialIconGeometryExt Cog}">
      <ContentControl Content="{Binding SettingsViewModel}" />
    </ContentPage>

  </TabbedPage>
  
</UserControl>
