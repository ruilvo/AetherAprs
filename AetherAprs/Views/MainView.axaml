<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:local="using:AetherAprs"
             xmlns:views="using:AetherAprs.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.MainView"
             x:DataType="vm:MainViewModel"
             d:DataContext="{x:Static local:DesignData.MainViewModel}">
  <Grid RowDefinitions="*,Auto">
    
    <!-- Main content area -->
    <ContentControl Grid.Row="0" Content="{Binding CurrentContent}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel">
          <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
          <views:SettingsView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
    
    <!-- Bottom navigation bar -->
    <Border Grid.Row="1" 
            BorderThickness="0,1,0,0" 
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <Grid ColumnDefinitions="*,*">
        
        <!-- Home tab button -->
        <Button Grid.Column="0" 
                Command="{Binding NavigateToHomeCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Padding="0,12">
          <StackPanel Spacing="4">
            <materialIcons:MaterialIcon Kind="Home" Width="24" Height="24" />
            <TextBlock Text="Home" FontSize="12" />
          </StackPanel>
        </Button>
        
        <!-- Settings tab button -->
        <Button Grid.Column="1" 
                Command="{Binding NavigateToSettingsCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Padding="0,12">
          <StackPanel Spacing="4">
            <materialIcons:MaterialIcon Kind="Cog" Width="24" Height="24" />
            <TextBlock Text="Settings" FontSize="12" />
          </StackPanel>
        </Button>
        
      </Grid>
    </Border>
    
  </Grid>
</UserControl>
