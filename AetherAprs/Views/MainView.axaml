<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherAprs.ViewModels"
             xmlns:local="using:AetherAprs"
             xmlns:views="using:AetherAprs.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="AetherAprs.Views.MainView"
             x:DataType="vm:MainViewModel"
             d:DataContext="{x:Static local:DesignData.MainViewModel}">
  <Grid RowDefinitions="*,Auto">
    
    <!-- Main content area -->
    <ContentControl Grid.Row="0" Content="{Binding CurrentContent}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel">
          <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
          <views:SettingsView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
    
    <!-- Bottom navigation bar -->
    <views:NavigationBarView Grid.Row="1" DataContext="{Binding NavigationBar}" />
    
  </Grid>
</UserControl>
