<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationId>com.AetherRadio.AetherAprs</ApplicationId>
    <!-- The version comes from the git tag: .github/scripts/build-release-apk.sh derives it
         with .github/scripts/extract-version.sh and passes both values as properties, so a
         release package never ships the placeholder below. The fallbacks only keep
         unsigned local builds installable. Android refuses to install a version code lower
         than the installed one, so signing a package without a derived version fails below
         instead of quietly publishing "1". -->
    <AetherAprsVersionSupplied Condition="'$(ApplicationVersion)' != '' and '$(ApplicationDisplayVersion)' != ''">true</AetherAprsVersionSupplied>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Device validation uses a self-contained APK; do not depend on Fast Deployment files. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Trimming is enabled for Release only: Debug builds stay untrimmed so the
         linker does not slow the edit loop. Every reflection hazard the trimmer
         reported has been removed (source-generated JSON, a trim-safe text length
         attribute, a modelled-free Logging section) or is a narrowly scoped,
         justified suppression where the reflective targets are statically rooted
         (EF Core's closed model, the MVVM validator's property attributes). -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <!-- Full trimming removes unused IL from the application and its dependencies as
         well as from the shared framework, which shrinks the APK further. It still
         needs a device check before it becomes the release default, so it stays opt-in:
         build the APK that check validates with -p:EnableFullTrimming=true. Without the
         flag a release keeps trimming only the shared framework. -->
    <TrimMode Condition="'$(Configuration)' == 'Release' and '$(EnableFullTrimming)' == 'true'">full</TrimMode>
    <!-- ILLink warnings accepted for statically rooted third-party code:
           - IL2035: Material.Avalonia's style toolkit carries a DynamicDependency to its
             optional TreeDataGrid style package, which this application does not
             reference. ILLink reports the dangling annotation even though those styles
             are never loaded, so it is suppressed here instead of adding an unused
             TreeDataGrid package only to satisfy an annotation.
           - IL2104 (an assembly produced trim warnings), which appears only once full
             trimming is enabled: Microsoft.EntityFrameworkCore, .Relational, .Sqlite and
             .Sqlite.Core build their model by reflection because no compiled model is
             generated, and Material.Styles loads its resources reflectively. Both sets of
             reflective targets are statically rooted here - every entity, mapping and
             style the application uses is referenced from AppDbContext and the
             application's XAML - so a fully trimmed build keeps them. The application's
             own assemblies are trim-clean: the core project runs the trim analyzer
             (IsTrimmable) and its hazards are cleared or narrowly suppressed. -->
    <NoWarn>$(NoWarn);IL2035;IL2104</NoWarn>
    <!-- .NET 11 Android runs on CoreCLR, so the release optimisation is ReadyToRun, not
         Mono AOT. Release builds therefore publish a composite ReadyToRun image. No MIBC
         profile is supplied, so crossgen2 precompiles every assembly rather than a profiled
         subset: the APK grows by roughly 19 MB, and startup pays for no JIT work on the
         precompiled code. Trimming must stay enabled for Release; without it the SDK turns
         ReadyToRun off and reports warning XA0119. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <PublishReadyToRunComposite Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRunComposite>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Assets\icon_400px.png">
      <Link>Resources\drawable\icon_400px.png</Link>
    </AndroidResource>
  </ItemGroup>

  <!-- A signed package must carry the version derived from its tag. The release workflow
       and build-release-apk.sh always supply it; this catches a hand-run publish that
       would otherwise ship version 1 and never upgrade an installed build. -->
  <Target Name="_RequireTagVersionForSignedPackage"
          BeforeTargets="_GetAndroidPackageName"
          Condition="'$(AndroidKeyStore)' == 'true' and '$(AetherAprsVersionSupplied)' != 'true'">
    <Error Code="APRS0001"
           Text="A signed package needs the version derived from its git tag. Pass -p:ApplicationVersion=(version code) and -p:ApplicationDisplayVersion=(version name), or run .github/scripts/build-release-apk.sh." />
  </Target>

  <!-- Always include base configuration file -->
  <ItemGroup>
    <AndroidAsset Include="..\AetherAprs\appsettings.json">
      <Link>Assets\appsettings.json</Link>
    </AndroidAsset>
  </ItemGroup>

  <!-- Only include Development configuration in DEBUG builds -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidAsset Include="..\AetherAprs\appsettings.Development.json">
      <Link>Assets\appsettings.Development.json</Link>
    </AndroidAsset>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="Xamarin.GooglePlayServices.Location" />
    <!--
      AvaloniaUI.DiagnosticsSupport flows in transitively from the core project (Debug only).
      Its Developer Tools auto-connect defaults to ON for Android and crashes the app with
      DevToolsUnreachableException when no Dev Tools instance is reachable (e.g. Debug builds
      on a physical device). Excluded here; desktop Debug builds keep the F12 Dev Tools.
    -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherAprs\AetherAprs.csproj" />
  </ItemGroup>
</Project>
