<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationId>com.AetherRadio.AetherAprs</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Assets\icon_400px.png">
      <Link>Resources\drawable\icon_400px.png</Link>
    </AndroidResource>
  </ItemGroup>

  <!-- Always include base configuration file -->
  <ItemGroup>
    <AndroidAsset Include="..\AetherAprs\appsettings.json">
      <Link>Assets\appsettings.json</Link>
    </AndroidAsset>
  </ItemGroup>

  <!-- Only include Development configuration in DEBUG builds -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidAsset Include="..\AetherAprs\appsettings.Development.json">
      <Link>Assets\appsettings.Development.json</Link>
    </AndroidAsset>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherAprs\AetherAprs.csproj" />
  </ItemGroup>
</Project>
