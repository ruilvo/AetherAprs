<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationId>com.AetherRadio.AetherAprs</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Device validation uses a self-contained APK; do not depend on Fast Deployment files. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <!-- Trimming is enabled for Release only: Debug builds stay untrimmed so the
         linker does not slow the edit loop. Every reflection hazard the trimmer
         reported has been removed (source-generated JSON, a trim-safe text length
         attribute, a modelled-free Logging section) or is a narrowly scoped,
         justified suppression where the reflective targets are statically rooted
         (EF Core's closed model, the MVVM validator's property attributes). -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <!-- Material.Avalonia's style toolkit carries a DynamicDependency to its optional
         TreeDataGrid style package, which this application does not reference. ILLink
         reports the dangling annotation as IL2035 even though those styles are never
         loaded, so the code is suppressed here instead of adding an unused TreeDataGrid
         package only to satisfy an annotation. -->
    <NoWarn>$(NoWarn);IL2035</NoWarn>
    <!-- .NET 11 Android runs on CoreCLR, where AOT means ReadyToRun and the
         RunAOTCompilation switch is rejected (XA1044). -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Assets\icon_400px.png">
      <Link>Resources\drawable\icon_400px.png</Link>
    </AndroidResource>
  </ItemGroup>

  <!-- Always include base configuration file -->
  <ItemGroup>
    <AndroidAsset Include="..\AetherAprs\appsettings.json">
      <Link>Assets\appsettings.json</Link>
    </AndroidAsset>
  </ItemGroup>

  <!-- Only include Development configuration in DEBUG builds -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidAsset Include="..\AetherAprs\appsettings.Development.json">
      <Link>Assets\appsettings.Development.json</Link>
    </AndroidAsset>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="Xamarin.GooglePlayServices.Location" />
    <!--
      AvaloniaUI.DiagnosticsSupport flows in transitively from the core project (Debug only).
      Its Developer Tools auto-connect defaults to ON for Android and crashes the app with
      DevToolsUnreachableException when no Dev Tools instance is reachable (e.g. Debug builds
      on a physical device). Excluded here; desktop Debug builds keep the F12 Dev Tools.
    -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherAprs\AetherAprs.csproj" />
  </ItemGroup>
</Project>
