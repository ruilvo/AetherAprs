root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,slnx,yml,yaml,axaml,json}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.cs]
# Parameters use camelCase (AGENTS.md). A captured primary-constructor parameter is
# a parameter at the source level and the compiler generates its backing field, so
# this rule must be evaluated before the private-field prefix rule below. Without
# it, every primary-constructor parameter is reported as a field missing "_".
dotnet_naming_rule.parameters_camel_case.severity = warning
dotnet_naming_rule.parameters_camel_case.symbols = parameters
dotnet_naming_rule.parameters_camel_case.style = camel_case
dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_style.camel_case.capitalization = camel_case

# Primary constructors are the preferred way to capture constructor arguments, so
# code that used to assign a parameter to a private field now captures it instead.
# Because the naming analyzer classifies a captured parameter as a field, a "private
# fields need _" rule would report every primary-constructor parameter and its only
# fix (renaming the parameter) contradicts the camelCase parameter rule above. The
# rule is therefore not expressed here; an explicitly declared private field still
# keeps the "_" prefix by convention.

# Expression bodies are preferred wherever they read as one phrase, including when
# the phrase wraps onto a second line, so no rule asks for a block body.
csharp_style_expression_bodied_methods = true:suggestion
csharp_style_expression_bodied_constructors = true:suggestion
csharp_style_expression_bodied_operators = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = true:suggestion

# Namespaces are file-scoped: one namespace per file and no extra indent level.
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0160.severity = none      # never suggest a block-scoped namespace

# Explicit types at declaration sites: 'var' hides the type where the reader needs it.
# Suggestion severity keeps the build green while allowing dotnet format to rewrite
# every declaration.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_diagnostic.IDE0008.severity = warning  # report 'var' so it can be rewritten, not ignored
dotnet_diagnostic.IDE0007.severity = none     # never push the other direction

# Quality: fail the build on the same classes of issues enforced today.
dotnet_diagnostic.CA2013.severity = error
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.VSTHRD002.severity = none

# Analyzer scope adjustments (documented deviations from latest-recommended).
# These rules conflict with project conventions or would require invasive churn
# disproportionate to their value; the important ones remain errors.
dotnet_diagnostic.CA1848.severity = none      # LoggerMessage source-gen delegates: pervasive, low value here
dotnet_diagnostic.CA1873.severity = none      # Expensive log arguments: negligible at APRS packet rates
dotnet_diagnostic.CA1305.severity = none        # Culture rules: user-facing strings are intentionally culture-aware, and the rule has no code fix
dotnet_diagnostic.CA1805.severity = none      # Explicit default initializers are intentional documentation
dotnet_diagnostic.CA1711.severity = none      # Existing public API names (e.g. CreateNew) would break
dotnet_diagnostic.CA1725.severity = none      # Parameter-name matching across interfaces is fine
dotnet_diagnostic.CA1846.severity = none      # AsSpan micro-optimization not warranted at these rates
dotnet_diagnostic.CA1859.severity = none      # concrete-type hints: measure first
dotnet_diagnostic.CA1861.severity = none      # constant array args in hot paths are fine
dotnet_diagnostic.CA1001.severity = error     # types with disposable fields must dispose
dotnet_diagnostic.CA1816.severity = error     # GC.SuppressFinalize contract
dotnet_diagnostic.CA1822.severity = error     # mark members static where possible
dotnet_diagnostic.CA1715.severity = error     # interfaces must start with I
dotnet_diagnostic.CA2263.severity = error     # prefer generic enum overloads

# Test project: underscore-separated test names (Method_Condition_Expectation)
# are the project's established convention — keep them.
[AetherAprs.Tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
