root = true

# ----------------------------------------------------------------------
# Global formatting
# ----------------------------------------------------------------------

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,slnx,yml,yaml,axaml,json}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# ----------------------------------------------------------------------
# C# conventions
# ----------------------------------------------------------------------

[*.cs]

# Import organization
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0005.severity = warning

# Namespace declarations
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0160.severity = none

# Prefer auto-properties over explicit backing fields where possible.
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_diagnostic.IDE0032.severity = warning

# Prefer pattern matching over explicit type checks and casts.
dotnet_style_prefer_pattern_matching = true
dotnet_diagnostic.IDE0078.severity = warning

# ----------------------------------------------------------------------
# Naming conventions
# ----------------------------------------------------------------------

# Parameters use camelCase (AGENTS.md).
# Primary-constructor parameters are intentionally not subject to
# the private-field underscore naming convention.

dotnet_naming_rule.parameters_camel_case.severity = warning
dotnet_naming_rule.parameters_camel_case.symbols = parameters
dotnet_naming_rule.parameters_camel_case.style = camel_case

dotnet_naming_symbols.parameters.applicable_kinds = parameter

dotnet_naming_style.camel_case.capitalization = camel_case

# Explicit private fields should use the "_" prefix.
# Intentionally no naming rule for private fields because captured
# primary-constructor parameters can be misclassified as fields.

# ----------------------------------------------------------------------
# Type declarations
# ----------------------------------------------------------------------

# Explicit types are preferred over var.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

dotnet_diagnostic.IDE0008.severity = warning
dotnet_diagnostic.IDE0007.severity = none

# Prefer predefined language types over framework type names.
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# ----------------------------------------------------------------------
# Expression-bodied members
# ----------------------------------------------------------------------

# Expression bodies are preferred wherever they read as one phrase,
# including expressions that wrap onto multiple lines.

csharp_style_expression_bodied_methods = true:suggestion
csharp_style_expression_bodied_constructors = true:suggestion
csharp_style_expression_bodied_operators = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = true:suggestion

# ----------------------------------------------------------------------
# C# syntax and simplification
# ----------------------------------------------------------------------

# Braces are mandatory, including for single-line statements.
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# Prefer modern C# constructs.
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_local_over_anonymous_function = true:suggestion
csharp_style_prefer_static_local_function = true:suggestion
csharp_style_prefer_simple_using_statement = true:suggestion

# Prefer collection expressions where supported.
dotnet_style_prefer_collection_expression = true:suggestion

# ----------------------------------------------------------------------
# Code quality and simplification
# ----------------------------------------------------------------------

# Prefer unqualified member access.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Prefer readonly fields when possible.
dotnet_style_readonly_field = true:suggestion

# Remove unnecessary syntax and declarations.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0008.severity = warning
dotnet_diagnostic.IDE0044.severity = suggestion
dotnet_diagnostic.IDE0051.severity = suggestion
dotnet_diagnostic.IDE0052.severity = suggestion
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0062.severity = suggestion
dotnet_diagnostic.IDE0063.severity = suggestion
dotnet_diagnostic.IDE0066.severity = suggestion
dotnet_diagnostic.IDE0071.severity = suggestion
dotnet_diagnostic.IDE0079.severity = warning
dotnet_diagnostic.IDE0090.severity = suggestion

# Formatting consistency.
dotnet_diagnostic.IDE0055.severity = warning

# ----------------------------------------------------------------------
# Analyzer quality rules
# ----------------------------------------------------------------------

# Quality: fail the build on important correctness issues.
dotnet_diagnostic.CA2013.severity = error
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.VSTHRD002.severity = none

# ----------------------------------------------------------------------
# Analyzer scope adjustments
# ----------------------------------------------------------------------

# Documented deviations from latest-recommended.
# These rules conflict with project conventions or would require
# invasive churn disproportionate to their value.

dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1725.severity = none
dotnet_diagnostic.CA1846.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1861.severity = none

# Important quality rules.
dotnet_diagnostic.CA1001.severity = error
dotnet_diagnostic.CA1816.severity = error
dotnet_diagnostic.CA1822.severity = error
dotnet_diagnostic.CA1715.severity = error
dotnet_diagnostic.CA2263.severity = error

# ----------------------------------------------------------------------
# Test project conventions
# ----------------------------------------------------------------------

# Underscore-separated test names (Method_Condition_Expectation)
# are the project's established convention.

[AetherAprs.Tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
